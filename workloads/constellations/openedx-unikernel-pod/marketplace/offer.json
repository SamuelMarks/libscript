{
  "$schema": "../../../../infrastructure/marketplace/marketplace-offer.schema.json",
  "offer_id": "openedx-unikernel-appliance",
  "publisher": "libscript",
  "product_title": "Open edX Hardened Multi-Unikernel Learning Appliance",
  "version": "22.1.0",
  "summary": "Decomposed single-address-space Open edX LMS, Studio/CMS, Celery, Caddy+MFE, Valkey, PostgreSQL/FerretDB, MySQL, and Meilisearch unikernel constellation.",
  "eula_uri": "LICENSE-APACHE",
  "sbom_path": "build/infrastructure/marketplace/openedx-unikernel-appliance/sbom.spdx.json",
  "pricing": {
    "model": "byol",
    "currency": "USD"
  },
  "architectures": ["x86_64"],
  "topology_ref": "workloads/constellations/openedx-unikernel-pod/topology.json",
  "appliance_images": [
    {
      "role": "ingress-mfe",
      "os_profile": "synthesis/profiles/unikernel/openedx/caddy-mfe-unikraft.json",
      "cloud_boot": "uefi-gpt",
      "default_instance_types": {
        "aws": "c7i.large",
        "azure": "Standard_F2s_v2",
        "gcp": "c3-standard-4"
      }
    },
    {
      "role": "lms-wsgi",
      "os_profile": "synthesis/profiles/unikernel/openedx/lms-nanos.json",
      "cloud_boot": "uefi-gpt",
      "default_instance_types": {
        "aws": "m7i.large",
        "azure": "Standard_D2s_v5",
        "gcp": "n2-standard-2"
      }
    },
    {
      "role": "cms-wsgi",
      "os_profile": "synthesis/profiles/unikernel/openedx/cms-nanos.json",
      "cloud_boot": "uefi-gpt",
      "default_instance_types": {
        "aws": "m7i.large",
        "azure": "Standard_D2s_v5",
        "gcp": "n2-standard-2"
      }
    },
    {
      "role": "celery-worker",
      "os_profile": "synthesis/profiles/unikernel/openedx/celery-nanos.json",
      "cloud_boot": "uefi-gpt",
      "default_instance_types": {
        "aws": "m7i.large",
        "azure": "Standard_D2s_v5",
        "gcp": "n2-standard-2"
      }
    },
    {
      "role": "cache-broker",
      "os_profile": "synthesis/profiles/unikernel/openedx/valkey-unikraft.json",
      "cloud_boot": "uefi-gpt",
      "default_instance_types": {
        "aws": "r7i.large",
        "azure": "Standard_E2s_v5",
        "gcp": "n2-highmem-2"
      }
    },
    {
      "role": "datastore-sql",
      "os_profile": "synthesis/profiles/unikernel/openedx/mysql-osv.json",
      "cloud_boot": "uefi-gpt",
      "default_instance_types": {
        "aws": "r7i.xlarge",
        "azure": "Standard_E4s_v5",
        "gcp": "n2-highmem-4"
      }
    },
    {
      "role": "datastore-doc",
      "os_profile": "synthesis/profiles/unikernel/openedx/ferretdb-osv.json",
      "cloud_boot": "uefi-gpt",
      "default_instance_types": {
        "aws": "r7i.large",
        "azure": "Standard_E2s_v5",
        "gcp": "n2-highmem-2"
      }
    },
    {
      "role": "search-index",
      "os_profile": "synthesis/profiles/unikernel/openedx/meilisearch-osv.json",
      "cloud_boot": "uefi-gpt",
      "default_instance_types": {
        "aws": "m7i.large",
        "azure": "Standard_D2s_v5",
        "gcp": "n2-standard-2"
      }
    }
  ],
  "exposed_endpoints": [
    {
      "name": "http-redirect",
      "port": 80,
      "protocol": "tcp",
      "health_path": "/heartbeat"
    },
    {
      "name": "https-ingress",
      "port": 443,
      "protocol": "tcp",
      "health_path": "/heartbeat"
    }
  ],
  "targets": {
    "aws_marketplace": {
      "enabled": true,
      "s3_staging_bucket": "libscript-marketplace-staging",
      "region": "us-east-1",
      "product_type": "CloudFormationProduct"
    },
    "azure_marketplace": {
      "enabled": true,
      "resource_group": "libscript-marketplace-rg",
      "storage_account": "libscriptmktstage",
      "compute_gallery": "libscript_unikernel_sig",
      "plan_id": "openedx-unikernel-byol"
    },
    "gcp_marketplace": {
      "enabled": true,
      "project_id": "libscript-marketplace-public",
      "gcs_staging_bucket": "libscript-gcp-marketplace-staging",
      "solution_id": "openedx-unikernel-appliance"
    }
  }
}
