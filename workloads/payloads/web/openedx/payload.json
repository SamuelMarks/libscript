{
  "$schema": "../../../schemas/payload.schema.json",
  "name": "openedx",
  "version": "22.1.0",
  "description": "Single-process or constellation-deployable Open edX LMS, Studio/CMS, and Celery learning workload.",
  "type": "unikernel",
  "artifact": {
    "format": "unikernel-binary",
    "entrypoint": ["/opt/openedx/lms/bin/openedx-lms"],
    "env": {
      "OPENEDX_ROLE": "lms",
      "OPENEDX_RELEASE": "release/verawood.1",
      "LMS_PORT": "8000",
      "CMS_PORT": "8001"
    },
    "profile_ref": "unikernel/openedx/lms-nanos"
  },
  "resources": {
    "cpu_cores": 4,
    "memory_mb": 8192
  },
  "scaling": {
    "replicas": 2,
    "strategy": "RollingUpdate",
    "restart_policy": "Always"
  },
  "ports": [
    {
      "name": "lms-http",
      "port": 8000,
      "protocol": "http",
      "visibility": "public"
    },
    {
      "name": "cms-http",
      "port": 8001,
      "protocol": "http",
      "visibility": "public"
    }
  ],
  "tenant_bindings": {
    "tenant_id": "openedx-default",
    "volumes": [
      {
        "name": "openedx-media",
        "mount_path": "/var/openedx/media",
        "size_gb": 50
      }
    ]
  }
}
