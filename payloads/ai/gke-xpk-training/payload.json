{
  "$schema": "../../payload.schema.json",
  "name": "gke-xpk-training",
  "version": "1.0.0",
  "description": "Distributed AI/ML gang-scheduled training workload executed on Google Kubernetes Engine (GKE) TPU/GPU slices via XPK.",
  "type": "ai-training",
  "artifact": {
    "format": "oci-image",
    "image": "gcr.io/cloud-tpu-v2-images/jax-ai-image:latest",
    "entrypoint": ["python", "train.py"],
    "args": ["--epochs=10", "--batch-size=128"],
    "working_dir": "/workspace"
  },
  "resources": {
    "cpu_cores": 32,
    "memory_mb": 131072,
    "tpu_accelerator_type": "v4-8",
    "tpu_topology": "2x2x1",
    "tpu_slice_count": 1
  },
  "scaling": {
    "replicas": 1,
    "strategy": "Recreate",
    "gang_scheduling": true,
    "restart_policy": "OnFailure"
  },
  "ports": [
    {
      "name": "tensorboard",
      "port": 6006,
      "protocol": "http",
      "visibility": "internal"
    }
  ]
}
