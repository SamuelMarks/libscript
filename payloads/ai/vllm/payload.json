{
  "$schema": "../../payload.schema.json",
  "name": "vllm",
  "version": "1.0.0",
  "description": "High-throughput PagedAttention LLM inference server supporting NVIDIA CUDA GPUs and Google Cloud TPUs.",
  "type": "ai-inference",
  "artifact": {
    "format": "oci-image",
    "image": "vllm/vllm-openai:latest",
    "entrypoint": ["python3", "-m", "vllm.entrypoints.openai.api_server"],
    "args": ["--host", "0.0.0.0", "--port", "8000"],
    "working_dir": "/workspace"
  },
  "resources": {
    "cpu_cores": 8,
    "memory_mb": 32768,
    "gpu_type": "nvidia-l4",
    "gpu_count": 1
  },
  "scaling": {
    "replicas": 1,
    "strategy": "RollingUpdate",
    "gang_scheduling": false,
    "restart_policy": "Always"
  },
  "ports": [
    {
      "name": "openai-api",
      "port": 8000,
      "protocol": "http",
      "visibility": "public"
    }
  ]
}
