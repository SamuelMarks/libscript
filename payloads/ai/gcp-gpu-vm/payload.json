{
  "$schema": "../../payload.schema.json",
  "name": "gcp-gpu-vm-workload",
  "version": "1.0.0",
  "description": "CUDA-accelerated model serving and training workload executing on Tier 3 GCP GPU VMs.",
  "type": "ai-inference",
  "artifact": {
    "format": "oci-image",
    "image": "vllm/vllm-openai:latest",
    "entrypoint": ["python3", "-m", "vllm.entrypoints.openai.api_server"],
    "args": ["--port", "8000"],
    "working_dir": "/workspace"
  },
  "resources": {
    "cpu_cores": 8,
    "memory_mb": 32768,
    "gpu_type": "nvidia-tesla-t4",
    "gpu_count": 1
  },
  "scaling": {
    "replicas": 1,
    "strategy": "RollingUpdate",
    "gang_scheduling": false,
    "restart_policy": "Always"
  },
  "ports": [
    {
      "name": "http",
      "port": 8000,
      "protocol": "http",
      "visibility": "public"
    }
  ]
}
