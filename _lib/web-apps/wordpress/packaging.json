{
  "$schema": "../../../packaging/packaging.schema.json",
  "name": "wordpress",
  "title": "WordPress 7.1.2 Platform",
  "version": "7.1.2.0",
  "publisher": "WordPress Foundation & LibScript Contributors",
  "upgrade_code": "B6C77413-58C9-4C41-8636-93026363B81A",
  "topology": "standalone",
  "database_contract": {
    "engine": "mysql",
    "min_version": "5.7",
    "allow_shared_instance": true,
    "default_schema_name": "wordpress",
    "default_user_name": "wordpress",
    "default_port": 3306,
    "character_set": "utf8mb4",
    "collation": "utf8mb4_unicode_520_ci",
    "ssl_required": false,
    "dbaas_supported": true
  },
  "branding_palette": {
    "primary_color": "#21759B",
    "secondary_color": "#0073AA",
    "dark_color": "#1E1E1E",
    "app_title": "WordPress Platform",
    "eula_components": ["WordPress Core", "PHP Runtime", "MariaDB Server", "Nginx HTTP Server"]
  },
  "branding": {
    "icon": "packaging/assets/wordpress.ico",
    "banner_top": "packaging/assets/wordpress_banner_top.bmp",
    "banner_side": "packaging/assets/wordpress_banner_side.bmp",
    "license_rtf": "packaging/assets/wordpress_eula.rtf",
    "license_mode": "consolidated_eula",
    "require_all_accepted": true,
    "bundled_licenses": [
      {
        "component": "wordpress",
        "title": "WordPress Publishing Platform",
        "spdx_id": "GPL-2.0-or-later",
        "mandatory": true
      },
      {
        "component": "php",
        "title": "PHP Hypertext Preprocessor Runtime",
        "spdx_id": "PHP-3.01",
        "mandatory": true
      },
      {
        "component": "mariadb",
        "title": "MariaDB Relational Database Management System",
        "spdx_id": "GPL-2.0-only",
        "mandatory": false
      },
      {
        "component": "nginx",
        "title": "Nginx HTTP and Reverse Proxy Server",
        "spdx_id": "BSD-2-Clause",
        "mandatory": false
      },
      {
        "component": "adminer",
        "title": "Adminer Database Management Tool",
        "spdx_id": "Apache-2.0 OR GPL-2.0-only",
        "mandatory": false
      }
    ]
  },
  "directories": {
    "app_default": "[ProgramFiles64Folder]WordPress",
    "data_default": "[CommonAppDataFolder]WordPress\\data",
    "logs_default": "[CommonAppDataFolder]WordPress\\logs",
    "backups_default": "[CommonAppDataFolder]WordPress\\backups"
  },
  "runtime_searches": [
    {
      "name": "php",
      "title": "PHP 8.2+ Execution Runtime",
      "required": true,
      "registry_searches": [
        {
          "root": "HKLM",
          "key": "SOFTWARE\\PHP\\8.3",
          "file": "php.exe"
        },
        {
          "root": "HKLM",
          "key": "SOFTWARE\\PHP\\8.2",
          "file": "php.exe"
        }
      ],
      "path_command": "php.exe",
      "version_regex": "8\\.[2-9]"
    },
    {
      "name": "nginx",
      "title": "Nginx / Caddy HTTP Server Runtime",
      "required": true,
      "path_command": "nginx.exe",
      "version_regex": "1\\.[0-9]+"
    }
  ],
  "source_repository": {
    "default_url": "https://github.com/WordPress/WordPress.git",
    "default_branch": "7.1.2",
    "presets": [
      {
        "label": "Stable (WordPress 7.1.2)",
        "value": "7.1.2"
      },
      {
        "label": "Development (master)",
        "value": "master"
      }
    ],
    "supports_auth_token": true
  },
  "wizard_copy": {
    "welcome_description_online": "The Setup Wizard will download and install WordPress 7.1.2 Platform and required runtimes on your computer.",
    "welcome_description_offline": "The Setup Wizard will deploy WordPress 7.1.2 Platform and pre-bundled air-gapped runtimes on your computer.",
    "exit_description": "WordPress 7.1.2 Platform services have been successfully installed and started.",
    "non_optional_summary": "- PHP 8.3+ (PHP-FPM FastCGI runtime & extensions)\n- Nginx / Caddy (High-performance HTTP & reverse proxy server)\n- MariaDB / MySQL (Relational database engine)\n- Redis (Persistent in-memory object cache)\n- WP-CLI (Command-line administration toolset)",
    "runtime_selection_description": "Configure PHP-FPM and Web Server execution runtime providers.",
    "port_1_label": "HTTP Web Port:",
    "port_1_default": "80",
    "port_2_label": "HTTPS / Admin Port:",
    "port_2_default": "443",
    "default_admin_email": "admin@wordpress.local",
    "default_theme": "twentytwentyfive"
  },
  "verification_screenshots": [
    {
      "id": "10b_desktop_icons",
      "title": "WordPress Desktop Shortcuts",
      "capture_type": "desktop",
      "crop_mode": "FULL",
      "view_spec": {
        "layout": "desktop_icons",
        "desktop_icons": [
          {
            "badge": "WP",
            "label": "WordPress Site",
            "color": "#21759B"
          },
          {
            "badge": "ADM",
            "label": "WordPress Admin Console",
            "color": "#0073AA"
          },
          {
            "badge": "CLI",
            "label": "WordPress CLI",
            "color": "#1E1E1E"
          }
        ]
      }
    },
    {
      "id": "11_browser_wordpress_home",
      "title": "WordPress 7.1.2 Public Frontend",
      "capture_type": "browser_unauthenticated",
      "crop_mode": "BROWSER",
      "service_port": 80,
      "healthcheck_path": "/",
      "url_template": "http://localhost:80/",
      "secondary_url_template": "http://localhost:80/wp-admin/",
      "view_spec": {
        "layout": "wp_frontend",
        "active_tab_title": "WordPress 7.1.2 | Just another site",
        "inactive_tab_title": "Log In < WordPress — WP",
        "active_tab_index": 1,
        "header_bg": "#1D2327",
        "header_brand": "W  WordPress 7.1.2",
        "header_subtitle": "+ New   Edit Site   Site Health: Good",
        "user_badge": "Howdy, wp_admin",
        "heading": "Welcome to WordPress 7.1.2",
        "subheading": "Deployed via LibScript Zero-Dependency Stack (PHP 8.3 + Nginx + MariaDB + Redis)",
        "cards": [
          {
            "title": "Hello world!",
            "subtitle": "Published October 22, 2026 by wp_admin in Uncategorized",
            "detail": "Welcome to WordPress 7.1.2. Your site is up and running with Twenty Twenty-Five block theme, OPcache JIT, and Redis object caching.",
            "badge": "Read More ->",
            "color": "#2271B1"
          }
        ]
      }
    },
    {
      "id": "12_browser_wp_admin_login",
      "title": "WordPress Admin Login (wp-login.php)",
      "capture_type": "browser_unauthenticated",
      "crop_mode": "BROWSER",
      "service_port": 80,
      "healthcheck_path": "/wp-login.php",
      "url_template": "http://localhost:80/wp-login.php?redirect_to=%2Fwp-admin%2F",
      "secondary_url_template": "http://localhost:80/",
      "view_spec": {
        "layout": "wp_login",
        "active_tab_title": "Log In < WordPress 7.1.2 — WordPress",
        "inactive_tab_title": "WordPress 7.1.2 | Home",
        "active_tab_index": 1,
        "header_bg": "#2271B1",
        "header_brand": "W",
        "header_subtitle": "WordPress 7.1.2 Publishing Platform",
        "heading": "Log in to WordPress Admin (wp-admin)",
        "subheading": "Username or Email Address: wp_admin",
        "cards": [
          {
            "title": "Username or Email Address",
            "subtitle": "wp_admin",
            "detail": "Remember Me",
            "badge": "Log In",
            "color": "#2271B1"
          }
        ]
      }
    },
    {
      "id": "13_browser_wp_admin_authenticated",
      "aliases": ["12_browser_wp_admin"],
      "title": "WordPress Admin Dashboard (Authenticated)",
      "capture_type": "browser_authenticated",
      "crop_mode": "BROWSER",
      "service_port": 80,
      "healthcheck_path": "/wp-login.php",
      "url_template": "http://localhost:80/wp-admin/",
      "auth_flow": {
        "login_url": "http://localhost:80/wp-login.php",
        "username_selector": "#user_login",
        "password_selector": "#user_pass",
        "submit_selector": "#wp-submit",
        "username_value": "wp_admin",
        "password_value": "wp_admin_pass",
        "ready_selector": "#wp-admin-bar"
      },
      "view_spec": {
        "layout": "wp_admin_dashboard",
        "active_tab_title": "Dashboard < WordPress 7.1.2 — WordPress",
