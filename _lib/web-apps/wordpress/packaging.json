            "badge": "Site Health Screen",
            "color": "#00A32A"
          }
        ]
      }
    },
    {
      "id": "14_browser_wp_site_health",
      "title": "WordPress Admin Site Health (Authenticated)",
      "capture_type": "browser_authenticated",
      "crop_mode": "BROWSER",
      "service_port": 80,
      "healthcheck_path": "/wp-login.php",
      "url_template": "http://localhost:80/wp-admin/site-health.php",
      "auth_flow": {
        "login_url": "http://localhost:80/wp-login.php",
        "username_selector": "#user_login",
        "password_selector": "#user_pass",
        "submit_selector": "#wp-submit",
        "username_value": "wp_admin",
        "password_value": "wp_admin_pass",
        "ready_selector": "#wp-admin-bar"
      },
      "view_spec": {
        "layout": "wp_site_health",
        "active_tab_title": "Site Health < WordPress 7.1.2 — WordPress",
        "inactive_tab_title": "Dashboard < WordPress 7.1.2",
        "active_tab_index": 2,
        "header_bg": "#1D2327",
        "header_brand": "W  WordPress 7.1.2",
        "header_subtitle": "+ New   Tools > Site Health",
        "user_badge": "Howdy, wp_admin",
        "heading": "Site Health",
        "subheading": "Site Health Status: Good (0 critical issues, 0 recommended improvements)",
        "sidebar_items": [
