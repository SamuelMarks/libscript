{
  "$schema": "../../_common/manifest.schema.json",
  "name": "openedx",
  "category": "web-apps",
  "title": "Open edX",
  "license": "AGPL-3.0-only",
  "license_name": "GNU Affero General Public License v3.0",
  "description": "Open edX LMS and Studio/CMS enterprise learning management platform.",
  "provides": ["openedx", "lms", "cms"],
  "runtime_deps": [
    "python",
    "nodejs",
    "mysql",
    "mongodb",
    "redis",
    "caddy",
    "meilisearch",
    "gunicorn",
    "waitress",
    "exim",
    "hmailserver",
    "lynx",
    "gettext",
    "nodeenv"
  ],
  "os_blacklist": [],
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/heartbeat"
  }
}
