{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["sysroot-package", "bootloader"],
  "category": "bootloaders",
  "description": "Standalone GNU GRand Unified Bootloader v2 (grub-install, grub-mkconfig, grub-mkstandalone) for BIOS and UEFI systems.",
  "name": "grub",
  "os_blacklist": ["windows"],
  "os_whitelist": ["linux", "freebsd", "openbsd", "netbsd", "sunos"],
  "provides": ["grub", "grub2", "grub-install", "grub-mkconfig"],
  "repository": "https://git.savannah.gnu.org/git/grub.git",
  "tier": "T2",
  "title": "GNU GRUB 2 Bootloader"
}
