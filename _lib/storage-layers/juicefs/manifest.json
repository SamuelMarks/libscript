{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "storage-layers",
  "description": "High-performance cloud-native POSIX distributed filesystem built on top of object storage and metadata engines.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "juicefs",
  "os_whitelist": ["all"],
  "ports": [9567],
  "provides": ["juicefs", "distributed-filesystem"],
  "repository": "https://github.com/juicedata/juicefs",
  "stateful": true,
  "tier": "T1",
  "title": "JuiceFS"
}
