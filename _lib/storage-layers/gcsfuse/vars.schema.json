{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/_lib/storage-layers/gcsfuse/vars.schema.json",
  "title": "GCSFUSE variables",
  "description": "Configuration variables for gcsfuse",
  "type": "object",
  "properties": {
    "GCSFUSE_VERSION": {
      "description": "Specific version of gcsfuse to install.",
      "type": "string",
      "default": "latest",
      "version_aliases": ["latest", "stable"]
    },
    "GCSFUSE_INSTALL_METHOD": {
      "description": "How to install gcsfuse.",
      "type": "string",
      "enum": ["libscript_native", "system", "mise", "asdf"],
      "default": "libscript_native"
    }
  }
}
