{
  "$schema": "../../_common/manifest.schema.json",
  "name": "garage",
  "title": "Garage",
  "description": "Lightweight geo-distributed S3-compatible object storage service designed for self-hosting.",
  "category": "storage-layers",
  "provides": ["garage", "s3-storage", "object-storage"],
  "os_whitelist": ["all"],
  "ports": [3900, 3901, 3902, 3903],
  "stateful": true,
  "multitenant": true,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
