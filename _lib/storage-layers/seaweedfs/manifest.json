{
  "$schema": "../../_common/manifest.schema.json",
  "name": "seaweedfs",
  "title": "SeaweedFS",
  "description": "Fast distributed blob storage, Filer POSIX filesystem, and S3-compatible object store with O(1) disk seek.",
  "category": "storage-layers",
  "provides": ["seaweedfs", "weed", "blob-storage", "s3-storage"],
  "os_whitelist": ["all"],
  "ports": [9333, 8080, 8888],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/seaweedfs/seaweedfs",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
