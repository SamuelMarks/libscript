{
  "$schema": "../../_common/manifest.schema.json",
  "name": "glusterfs",
  "title": "GlusterFS",
  "description": "Scalable distributed network filesystem aggregating disk storage resources into a unified namespace.",
  "category": "storage-layers",
  "provides": ["glusterfs", "network-filesystem"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows", "darwin"],
  "ports": [24007],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/gluster/glusterfs",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
