{
  "$schema": "../../_common/manifest.schema.json",
  "name": "ceph",
  "title": "Ceph",
  "description": "Unified distributed storage cluster providing RADOS object, RBD block, and CephFS file storage.",
  "category": "storage-layers",
  "provides": ["ceph", "distributed-storage", "object-storage"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows", "darwin"],
  "ports": [6789, 3300],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/ceph/ceph",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
