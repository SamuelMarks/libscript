{
  "$schema": "../../_common/manifest.schema.json",
  "name": "forgejo",
  "title": "Forgejo",
  "description": "Self-hosted lightweight community-governed software forge supporting Git, CI/CD Actions, and packages.",
  "category": "git-servers",
  "provides": ["forgejo", "git-server"],
  "os_whitelist": ["all"],
  "ports": [3000, 22],
  "stateful": true,
  "multitenant": true,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
