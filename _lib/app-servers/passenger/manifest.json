{
  "$schema": "../../_common/manifest.schema.json",
  "name": "passenger",
  "title": "Phusion Passenger",
  "description": "Polyglot web and application server supporting Ruby, Node.js, Python, and Meteor workloads.",
  "category": "app-servers",
  "provides": ["passenger", "rack-server", "app-server"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows"],
  "ports": [3000],
  "multitenant": true,
  "repository": "https://github.com/phusion/passenger",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
