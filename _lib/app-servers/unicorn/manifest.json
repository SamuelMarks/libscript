{
  "$schema": "../../_common/manifest.schema.json",
  "name": "unicorn",
  "title": "Unicorn",
  "description": "Rack HTTP server for fast clients and Unix-like operating systems utilizing pre-forking worker processes.",
  "category": "app-servers",
  "provides": ["unicorn", "rack-server", "app-server"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows"],
  "ports": [8080],
  "multitenant": true,
  "repository": "https://github.com/defunkt/unicorn",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
