{
  "$schema": "../../_common/manifest.schema.json",
  "name": "jetty",
  "title": "Eclipse Jetty",
  "description": "Lightweight, highly scalable Java HTTP web server and Jakarta Servlet container.",
  "category": "app-servers",
  "provides": ["jetty", "servlet-container", "app-server"],
  "os_whitelist": ["all"],
  "ports": [8080, 8443],
  "multitenant": true,
  "repository": "https://github.com/jetty/jetty.project",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
