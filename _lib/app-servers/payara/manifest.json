{
  "$schema": "../../_common/manifest.schema.json",
  "name": "payara",
  "title": "Payara Server",
  "description": "Cloud-native open-source Jakarta EE and MicroProfile enterprise application server runtime.",
  "category": "app-server",
  "provides": ["payara", "jakarta-ee", "app-server"],
  "os_whitelist": ["all"],
  "ports": [8080, 4848],
  "multitenant": true,
  "repository": "https://github.com/payara/Payara",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
