{
  "$schema": "../../_common/manifest.schema.json",
  "name": "puma",
  "title": "Puma",
  "description": "Fast, multithreaded, and highly concurrent HTTP 1.1 server for Ruby and Rack applications.",
  "category": "app-server",
  "provides": ["puma", "rack-server", "app-server"],
  "os_whitelist": ["all"],
  "ports": [9292],
  "multitenant": true,
  "repository": "https://github.com/puma/puma",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
