{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "app-servers",
  "description": "Fast, multithreaded, and highly concurrent HTTP 1.1 server for Ruby and Rack applications.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "puma",
  "os_whitelist": ["all"],
  "ports": [9292],
  "provides": ["puma", "rack-server", "app-server"],
  "repository": "https://github.com/puma/puma",
  "tier": "T1",
  "title": "Puma"
}
