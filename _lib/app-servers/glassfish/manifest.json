{
  "$schema": "../../_common/manifest.schema.json",
  "name": "glassfish",
  "title": "Eclipse GlassFish",
  "description": "Eclipse Foundation open-source Jakarta EE compatible enterprise application server.",
  "category": "app-server",
  "provides": ["glassfish", "jakarta-ee", "app-server"],
  "os_whitelist": ["all"],
  "ports": [8080, 4848],
  "multitenant": true,
  "repository": "https://github.com/eclipse-ee4j/glassfish",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
