{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "app-servers",
  "description": "Flexible, lightweight, managed Jakarta EE and MicroProfile application runtime.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "wildfly",
  "os_whitelist": ["all"],
  "ports": [8080, 9990],
  "provides": ["wildfly", "jakarta-ee", "app-server"],
  "repository": "https://github.com/wildfly/wildfly",
  "tier": "T1",
  "title": "WildFly"
}
