{
  "$schema": "../../_common/manifest.schema.json",
  "name": "pm2",
  "title": "PM2",
  "description": "Production process manager and cluster load balancer for Node.js and polyglot applications.",
  "category": "app-server",
  "provides": ["pm2", "process-manager", "app-server"],
  "os_whitelist": ["all"],
  "ports": [9615],
  "multitenant": true,
  "repository": "https://github.com/Unitech/pm2",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
