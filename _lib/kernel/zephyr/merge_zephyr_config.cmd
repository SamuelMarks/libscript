@echo off
:: # merge_zephyr_config.cmd
::
:: ## Overview
:: Deterministic Zephyr Kconfig (.conf) fragment and Devicetree (.overlay) merger on Windows.
::
:: ## Usage
:: merge_zephyr_config.cmd <out_dir> [board] [kconfig_csv] [dts_csv]

setlocal EnableDelayedExpansion
set "THIS_FILE=%~f0"

if defined STACK (
    echo "!STACK!" | findstr /I /C:":!THIS_FILE!:" >nul 2>&1
    if not errorlevel 1 (
        echo [STOP] processing "!THIS_FILE!" >&2
        exit /b 0
    )
)
set "STACK=%STACK%:!THIS_FILE!:"

set "SCRIPT_DIR=%~dp0"
if "%SCRIPT_DIR:~-1%"=="\" set "SCRIPT_DIR=%SCRIPT_DIR:~0,-1%"

if not defined LIBSCRIPT_ROOT_DIR (
    set "d=!SCRIPT_DIR!"
    call :find_root
)
goto :root_found

:: ## find_root
:: Ascends the directory tree looking for ROOT or libscript.cmd.
:find_root
if exist "!d!\libscript.cmd" (
    set "LIBSCRIPT_ROOT_DIR=!d!"
    exit /b 0
)
if exist "!d!\ROOT" (
    set "LIBSCRIPT_ROOT_DIR=!d!"
    exit /b 0
)
for %%P in ("!d!") do set "parent=%%~dpP"
set "d=!parent:~0,-1!"
if "!d!"=="" (
    echo Error: Could not find LIBSCRIPT_ROOT_DIR 1>&2
    exit /b 1
)
goto :find_root

:: ## root_found
:: Continues execution once LIBSCRIPT_ROOT_DIR is verified.
:root_found

set "OUT_DIR=%~1"
set "BOARD=%~2"
if "!BOARD!"=="" set "BOARD=%ZEPHYR_BOARD%"
if "!BOARD!"=="" set "BOARD=%LIBSCRIPT_RTOS_BOARD%"
if "!BOARD!"=="" set "BOARD=qemu_x86_64"
set "KCONFIG_CSV=%~3"
if "!KCONFIG_CSV!"=="" set "KCONFIG_CSV=%ZEPHYR_KCONFIG_FRAGMENTS%"
if "!KCONFIG_CSV!"=="" set "KCONFIG_CSV=minimal_footprint.conf,picolibc.conf"
set "DTS_CSV=%~4"
if "!DTS_CSV!"=="" set "DTS_CSV=%ZEPHYR_DTS_OVERLAYS%"

if "!OUT_DIR!"=="" (
    echo [ERROR] Usage: merge_zephyr_config.cmd ^<out_dir^> [board] [kconfig_csv] [dts_csv] >&2
    exit /b 1
)
if not exist "!OUT_DIR!" mkdir "!OUT_DIR!"

set "CONF_OUT=!OUT_DIR!\.config"
set "PRJ_OUT=!OUT_DIR!\prj.merged.conf"
set "HDR_OUT=!OUT_DIR!\autoconf.h"
set "DTS_OUT=!OUT_DIR!\zephyr.dts"

> "!CONF_OUT!" echo # Merged by LibScript Zephyr Kconfig Engine for board=!BOARD!
for %%F in (!KCONFIG_CSV!) do (
    set "_FP=%%~F"
    if not exist "!_FP!" if exist "!SCRIPT_DIR!\configs\%%~F" set "_FP=!SCRIPT_DIR!\configs\%%~F"
    if not exist "!_FP!" if exist "!SCRIPT_DIR!\configs\%%~F.conf" set "_FP=!SCRIPT_DIR!\configs\%%~F.conf"
    if exist "!_FP!" (
        >> "!CONF_OUT!" echo # --- Fragment: %%~nxF ---
        type "!_FP!" >> "!CONF_OUT!"
        >> "!CONF_OUT!" echo.
    )
)
copy /y "!CONF_OUT!" "!PRJ_OUT!" >nul

> "!HDR_OUT!" echo /* Auto-generated by LibScript merge_zephyr_config.cmd */
>> "!HDR_OUT!" echo #ifndef LIBSCRIPT_ZEPHYR_AUTOCONF_H
>> "!HDR_OUT!" echo #define LIBSCRIPT_ZEPHYR_AUTOCONF_H
>> "!HDR_OUT!" echo #define CONFIG_BOARD "!BOARD!"
for /f "usebackq tokens=1,2 delims==" %%A in ("!CONF_OUT!") do (
    set "_K=%%A"
    if "!_K:~0,7!"=="CONFIG_" (
        if "%%B"=="y" (
            >> "!HDR_OUT!" echo #define %%A 1
        ) else if not "%%B"=="n" (
            >> "!HDR_OUT!" echo #define %%A %%B
        )
    )
)
>> "!HDR_OUT!" echo #endif

> "!DTS_OUT!" echo /dts-v1/;
>> "!DTS_OUT!" echo / { model = "LibScript Zephyr !BOARD! Appliance"; compatible = "zephyr,!BOARD!"; };
if not "!DTS_CSV!"=="" (
    for %%O in (!DTS_CSV!) do (
        if exist "%%~O" type "%%~O" >> "!DTS_OUT!"
    )
)
exit /b 0
