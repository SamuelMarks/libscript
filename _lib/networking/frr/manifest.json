{
  "$schema": "../../_common/manifest.schema.json",
  "name": "frr",
  "title": "FRRouting (FRR) Routing Suite",
  "description": "FRRouting IP routing protocol suite implementing BGP, OSPF, RIP, IS-IS, PIM, LDP, BFD, Babel, and EVPN (vtysh, zebra, bgpd, ospfd).",
  "category": "networking",
  "provides": ["frr", "frrouting", "vtysh", "bgpd", "ospfd"],
  "os_whitelist": ["linux", "freebsd", "openbsd", "netbsd"],
  "os_blacklist": ["windows"],
  "ports": [179, 2601],
  "repository": "https://github.com/FRRouting/frr",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
