{
  "$schema": "../../_common/manifest.schema.json",
  "name": "keepalived",
  "title": "Keepalived VRRP & LVS High-Availability Daemon",
  "description": "Keepalived VRRPv2/v3 virtual router redundancy and Linux Virtual Server (IPVS) load-balancing healthcheck daemon.",
  "category": "networking",
  "provides": ["keepalived"],
  "os_whitelist": ["linux"],
  "repository": "https://github.com/acassen/keepalived",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
