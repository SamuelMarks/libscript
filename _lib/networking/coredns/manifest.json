{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "networking",
  "description": "CoreDNS cloud-native, plugin-driven DNS server and service discovery engine.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "coredns",
  "os_whitelist": ["all"],
  "ports": [53, 9153],
  "provides": ["coredns", "dns-server"],
  "repository": "https://github.com/coredns/coredns",
  "tier": "T1",
  "title": "CoreDNS"
}
