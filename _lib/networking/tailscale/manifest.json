{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["sysroot-package", "service-daemon"],
  "category": "networking",
  "description": "Tailscale zero-config WireGuard mesh VPN client and daemon (tailscale and tailscaled).",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "tailscale",
  "os_whitelist": ["all"],
  "ports": [41641],
  "provides": ["tailscale", "tailscaled"],
  "repository": "https://github.com/tailscale/tailscale",
  "tier": "T2",
  "title": "Tailscale Mesh VPN"
}
