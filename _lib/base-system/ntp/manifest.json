{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["sysroot-package", "service-daemon"],
  "category": "base-system",
  "description": "Reference Network Time Protocol (NTP) clock synchronization daemon (ntpd) and query tools.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "ntp",
  "os_whitelist": ["all"],
  "ports": [123],
  "provides": ["ntp", "ntpd", "ntpq"],
  "repository": "https://www.ntp.org/",
  "tier": "T2",
  "title": "Network Time Protocol Daemon (ntpd)"
}
