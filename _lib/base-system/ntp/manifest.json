{
  "$schema": "../../_common/manifest.schema.json",
  "name": "ntp",
  "title": "Network Time Protocol Daemon (ntpd)",
  "description": "Reference Network Time Protocol (NTP) clock synchronization daemon (ntpd) and query tools.",
  "category": "base-system",
  "provides": ["ntp", "ntpd", "ntpq"],
  "os_whitelist": ["all"],
  "ports": [123],
  "repository": "https://www.ntp.org/",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
