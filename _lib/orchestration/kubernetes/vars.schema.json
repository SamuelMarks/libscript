{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/_lib/orchestration/kubernetes/vars.schema.json",
  "title": "Kubernetes variables",
  "description": "Configuration variables for Kubernetes tools",
  "type": "object",
  "properties": {
    "KUBERNETES_VERSION": {
      "description": "Specific version of Kubernetes/kubectl to install.",
      "type": "string",
      "default": "latest",
      "version_aliases": ["latest", "stable"]
    },
    "KUBERNETES_INSTALL_METHOD": {
      "description": "How to install Kubernetes tools.",
      "type": "string",
      "enum": ["libscript_native", "system"],
      "default": "libscript_native"
    },
    "KUBERNETES_DOWNLOAD_URL": {
      "type": "string",
      "description": "Override URL for downloading kubernetes binary or archive artifacts."
    },
    "KUBERNETES_RELEASES_URL": {
      "type": "string",
      "description": "Override URL for querying kubernetes available remote releases."
    }
  }
}
