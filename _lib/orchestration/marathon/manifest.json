{
  "$schema": "../../_common/manifest.schema.json",
  "name": "marathon",
  "title": "Marathon Framework",
  "description": "Production-grade container and application orchestration framework for Apache Mesos.",
  "category": "orchestration",
  "provides": ["marathon"],
  "conflicts": [],
  "os_whitelist": ["all"],
  "os_blacklist": [],
  "versions": ["1.11.28", "1.10.0", "latest"],
  "ports": [8080],
  "stateful": true,
  "multitenant": true,
  "dependencies": {
    "runtime_deps": ["java", "mesos"],
    "tier": "recommended"
  },
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
