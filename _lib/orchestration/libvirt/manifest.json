{
  "$schema": "../../_common/manifest.schema.json",
  "name": "libvirt",
  "title": "libvirt Virtualization API & Daemon",
  "description": "Open-source virtualization management API, daemon (libvirtd / virtqemud), and CLI shell (virsh) for QEMU/KVM, Xen, LXC, and Bhyve.",
  "category": "orchestration",
  "provides": ["libvirt", "virsh", "libvirtd"],
  "os_whitelist": ["all"],
  "ports": [16509],
  "repository": "https://gitlab.com/libvirt/libvirt",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
