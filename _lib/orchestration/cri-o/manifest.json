{
  "$schema": "../../_common/manifest.schema.json",
  "name": "cri-o",
  "title": "CRI-O Kubernetes Container Runtime",
  "description": "Lightweight OCI-based implementation of the Kubernetes Container Runtime Interface (crio).",
  "category": "orchestration",
  "provides": ["cri-o", "crio"],
  "os_whitelist": ["linux", "freebsd"],
  "os_blacklist": ["windows"],
  "repository": "https://github.com/cri-o/cri-o",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
