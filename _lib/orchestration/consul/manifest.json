{
  "$schema": "../../_common/manifest.schema.json",
  "name": "consul",
  "title": "HashiCorp Consul",
  "description": "HashiCorp Consul service mesh, multi-datacenter service discovery, health checking, and distributed key-value store.",
  "category": "orchestration",
  "provides": ["consul"],
  "os_whitelist": ["all"],
  "ports": [8500, 8600],
  "repository": "https://github.com/hashicorp/consul",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
