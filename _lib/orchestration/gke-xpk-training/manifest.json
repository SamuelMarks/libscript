{
  "$schema": "../../_common/manifest.schema.json",
  "name": "gke-xpk-training",
  "title": "GKE XPK Training",
  "description": "Deploys a generic ML training job to a Google Cloud TPU or GPU Pod via XPK.",
  "category": "orchestration",
  "provides": ["ml-training-orchestrator", "gke-xpk-training"],
  "conflicts": [],
  "os_whitelist": ["linux"],
  "os_blacklist": ["windows", "sunos", "freebsd", "bsd", "darwin"],
  "dependencies": {
    "runtime_deps": ["gcp-cli", "python", "kubectl", "xpk"]
  }
}
