{
  "$schema": "../../_common/manifest.schema.json",
  "name": "lxd",
  "title": "Canonical LXD System Container & VM Manager",
  "description": "Canonical LXD next-generation system container and virtual machine manager daemon (lxd) and REST CLI client (lxc).",
  "category": "orchestration",
  "provides": ["lxd", "lxd-client"],
  "os_whitelist": ["linux", "macos", "windows"],
  "ports": [8443],
  "repository": "https://github.com/canonical/lxd",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
