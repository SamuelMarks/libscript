{
  "$schema": "../../_common/manifest.schema.json",
  "name": "mesos",
  "title": "Apache Mesos",
  "description": "Distributed systems kernel abstracting CPU, memory, storage, and compute resources across machines.",
  "category": "orchestration",
  "provides": ["mesos", "mesos-master", "mesos-agent", "mesos-local"],
  "conflicts": [],
  "os_whitelist": ["all"],
  "os_blacklist": [],
  "versions": ["1.11.0", "1.10.1", "latest"],
  "ports": [5050, 5051],
  "stateful": true,
  "multitenant": true,
  "dependencies": {
    "runtime_deps": ["zookeeper"],
    "tier": "recommended"
  },
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics/snapshot"
  }
}
