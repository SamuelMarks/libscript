{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["sysroot-package"],
  "category": "desktops",
  "description": "MATE Desktop Environment session manager, panel, and traditional GTK desktop suite (mate-session).",
  "name": "mate",
  "os_blacklist": ["windows", "macos"],
  "os_whitelist": ["linux", "freebsd", "openbsd", "netbsd", "sunos"],
  "provides": ["mate", "mate-desktop", "mate-session"],
  "repository": "https://github.com/mate-desktop/mate-session-manager",
  "tier": "T2",
  "title": "MATE Desktop Environment"
}
