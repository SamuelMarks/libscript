{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["sysroot-package"],
  "category": "desktops",
  "description": "Dynamic tiling X11 window manager (i3, i3-msg, i3bar) designed for keyboard-driven workflows.",
  "name": "i3",
  "os_blacklist": ["windows", "macos"],
  "os_whitelist": ["linux", "freebsd", "openbsd", "netbsd", "sunos"],
  "provides": ["i3", "i3wm", "i3-msg"],
  "repository": "https://github.com/i3/i3",
  "tier": "T2",
  "title": "i3 Tiling Window Manager"
}
