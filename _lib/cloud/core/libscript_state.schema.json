{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LibScript Cloud State File Schema",
  "description": "Schema for .libscript_state.json used to track managed cloud resources.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "State file format version (e.g. '1.0')."
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last modification."
    },
    "provider": {
      "type": "string",
      "enum": ["aws", "azure", "gcp"],
      "description": "The cloud provider this state belongs to."
    },
    "resources": {
      "type": "array",
      "description": "List of tracked cloud resources.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["node", "network", "floating_ip", "disk", "security_group", "snapshot"],
            "description": "The type of the resource."
          },
          "id": {
            "type": "string",
            "description": "The provider-specific unique ID of the resource (e.g. i-1234567890abcdef0)."
          },
          "name": {
            "type": "string",
            "description": "The logical name assigned by LibScript (e.g. my-node-1)."
          },
          "region": {
            "type": "string",
            "description": "The cloud region or zone where the resource is deployed."
          },
          "metadata": {
            "type": "object",
            "description": "Additional provider-specific metadata.",
            "additionalProperties": true
          },
          "retained": {
            "type": "boolean",
            "description": "Indicates if the resource was explicitly retained during deprovisioning."
          }
        },
        "required": ["type", "id", "name"]
      }
    }
  },
  "required": ["version", "provider", "resources"]
}
