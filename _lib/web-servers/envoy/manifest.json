{
  "$schema": "../../_common/manifest.schema.json",
  "name": "envoy",
  "title": "Envoy",
  "description": "Cloud-native high-performance C++ distributed L4/L7 edge and service proxy.",
  "category": "web-server",
  "provides": ["envoy", "reverse-proxy", "edge-router", "load-balancer", "web-server"],
  "os_whitelist": ["all"],
  "ports": [10000, 9901],
  "multitenant": true,
  "repository": "https://github.com/envoyproxy/envoy",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
