{
  "$schema": "../../_common/manifest.schema.json",
  "name": "traefik",
  "title": "Traefik",
  "description": "Modern HTTP reverse proxy and cloud-native edge router with automatic service discovery and TLS.",
  "category": "web-servers",
  "provides": ["traefik", "reverse-proxy", "edge-router", "web-server"],
  "os_whitelist": ["all"],
  "ports": [80, 443, 8080],
  "multitenant": true,
  "repository": "https://github.com/traefik/traefik",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
