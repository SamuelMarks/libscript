{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "web-servers",
  "conflicts": [],
  "description": "A powerful, enterprise-ready, open source web server with automatic HTTPS written in Go.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "caddy",
  "os_blacklist": [],
  "os_whitelist": ["all"],
  "ports": [80, 443],
  "process_model": "single-process",
  "provides": ["web-server", "reverse-proxy", "caddy"],
  "stateful": false,
  "tier": "T1",
  "title": "Caddy",
  "unikernel_support": ["unikraft", "nanos", "osv"]
}
