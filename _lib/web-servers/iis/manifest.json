{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "web-servers",
  "conflicts": [],
  "description": "Flexible, secure and manageable Web server for hosting anything on the Web.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "iis",
  "os_blacklist": [],
  "os_whitelist": ["windows"],
  "ports": ["80", "443"],
  "provides": ["web-server", "iis"],
  "stateful": false,
  "tier": "T1",
  "title": "Internet Information Services"
}
