{
  "$schema": "../../_common/manifest.schema.json",
  "name": "iis",
  "title": "Internet Information Services",
  "description": "Flexible, secure and manageable Web server for hosting anything on the Web.",
  "category": "web-servers",
  "provides": ["web-server", "iis"],
  "conflicts": [],
  "os_whitelist": ["windows"],
  "os_blacklist": [],
  "ports": ["80", "443"],
  "stateful": false,
  "multitenant": true,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
