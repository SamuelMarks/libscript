{
  "$schema": "../../_common/manifest.schema.json",
  "name": "haproxy",
  "title": "HAProxy",
  "description": "Reliable, high-performance TCP/HTTP load balancer and proxy server for high-availability systems.",
  "category": "web-servers",
  "provides": ["haproxy", "load-balancer", "reverse-proxy"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows"],
  "ports": [80, 443, 8404],
  "multitenant": true,
  "repository": "https://github.com/haproxy/haproxy",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
