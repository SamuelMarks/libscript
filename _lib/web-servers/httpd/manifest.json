{
  "$schema": "../../_common/manifest.schema.json",
  "name": "httpd",
  "title": "Apache HTTPD",
  "description": "The Apache HTTP Server, a secure, efficient and extensible server that provides HTTP services in sync with the current HTTP standards.",
  "category": "web-servers",
  "provides": ["web-server", "apache", "httpd"],
  "conflicts": [],
  "os_whitelist": ["all"],
  "os_blacklist": ["sunos"],
  "ports": [80, 443],
  "stateful": false,
  "multitenant": true,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
