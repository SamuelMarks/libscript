{
  "$schema": "../../_common/manifest.schema.json",
  "name": "tomcat",
  "title": "Apache Tomcat",
  "description": "Open-source implementation of Jakarta Servlet, Jakarta Server Pages, and WebSocket specifications.",
  "category": "web-server",
  "provides": ["tomcat", "servlet-container", "web-server"],
  "os_whitelist": ["all"],
  "ports": [8080, 8009],
  "multitenant": true,
  "repository": "https://github.com/apache/tomcat",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
