{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "web-servers",
  "conflicts": [],
  "description": "A high-performance HTTP and reverse proxy server, as well as a mail proxy server.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "nginx",
  "os_blacklist": ["sunos"],
  "os_whitelist": ["all"],
  "ports": [80, 443],
  "provides": ["web-server", "reverse-proxy", "nginx"],
  "stateful": false,
  "tier": "T1",
  "title": "Nginx"
}
