{
  "$schema": "../../_common/manifest.schema.json",
  "name": "nginx",
  "title": "Nginx",
  "description": "A high-performance HTTP and reverse proxy server, as well as a mail proxy server.",
  "category": "web-servers",
  "provides": ["web-server", "reverse-proxy", "nginx"],
  "conflicts": [],
  "os_whitelist": ["all"],
  "os_blacklist": ["sunos"],
  "ports": [80, 443],
  "stateful": false,
  "multitenant": true,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
