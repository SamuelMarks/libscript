{
  "$schema": "../../_common/manifest.schema.json",
  "name": "influxdb",
  "title": "InfluxDB",
  "description": "Scalable datastore purpose-built for metrics, events, and real-time time-series analytics.",
  "category": "databases",
  "provides": ["influxdb", "tsdb", "database"],
  "os_whitelist": ["all"],
  "ports": [8086],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/influxdata/influxdb",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
