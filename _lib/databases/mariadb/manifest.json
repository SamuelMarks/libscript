{
  "$schema": "../../_common/manifest.schema.json",
  "name": "mariadb",
  "title": "MariaDB",
  "license": "GPL-2.0-only",
  "license_name": "GNU General Public License v2.0 only",
  "description": "A community-developed, commercially supported fork of the MySQL relational database management system.",
  "category": "databases",
  "provides": ["database", "mysql-compatible", "mariadb"],
  "conflicts": ["mysql"],
  "os_whitelist": ["all"],
  "os_blacklist": [],
  "ports": [3306],
  "stateful": true,
  "multitenant": true,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  },
  "repository": "https://github.com/MariaDB/server"
}
