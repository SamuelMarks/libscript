{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "databases",
  "conflicts": [],
  "description": "A distributed, reliable key-value store for the most critical data of a distributed system.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": false,
  "name": "etcd",
  "os_blacklist": ["sunos"],
  "os_whitelist": ["all"],
  "ports": [2379, 2380],
  "provides": ["kv-store", "etcd"],
  "stateful": true,
  "tier": "T1",
  "title": "Etcd"
}
