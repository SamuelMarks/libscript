{
  "$schema": "../../_common/manifest.schema.json",
  "name": "etcd",
  "title": "Etcd",
  "description": "A distributed, reliable key-value store for the most critical data of a distributed system.",
  "category": "databases",
  "provides": ["kv-store", "etcd"],
  "conflicts": [],
  "os_whitelist": ["all"],
  "os_blacklist": ["sunos"],
  "ports": [2379, 2380],
  "stateful": true,
  "multitenant": false,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
