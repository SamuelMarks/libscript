{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "databases",
  "description": "Scalable distributed multi-model cloud database supporting relational, document, graph, and vector queries.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "surrealdb",
  "os_whitelist": ["all"],
  "ports": [8000],
  "provides": ["surrealdb", "multi-model-database", "database"],
  "repository": "https://github.com/surrealdb/surrealdb",
  "stateful": true,
  "tier": "T1",
  "title": "SurrealDB"
}
