{
  "$schema": "../../_common/manifest.schema.json",
  "name": "firebird",
  "title": "Firebird SQL",
  "description": "Open-source relational SQL database management system offering ANSI SQL standard compliance and stored procedures.",
  "category": "database",
  "provides": ["firebird", "sql-database", "database"],
  "os_whitelist": ["all"],
  "ports": [3050],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/FirebirdSQL/firebird",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
