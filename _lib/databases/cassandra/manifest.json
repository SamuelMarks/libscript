{
  "$schema": "../../_common/manifest.schema.json",
  "name": "cassandra",
  "title": "Apache Cassandra",
  "description": "Distributed wide-column NoSQL database designed to handle large amounts of data across commodity servers with high availability.",
  "category": "database",
  "provides": ["cassandra", "wide-column-store", "database"],
  "os_whitelist": ["all"],
  "ports": [9042, 7000],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/apache/cassandra",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
