{
  "$schema": "../../_common/manifest.schema.json",
  "name": "clickhouse",
  "title": "ClickHouse",
  "description": "High-performance column-oriented SQL database management system for online analytical processing (OLAP).",
  "category": "databases",
  "provides": ["clickhouse", "olap-database", "database"],
  "os_whitelist": ["all"],
  "ports": [8123, 9000],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/ClickHouse/ClickHouse",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
