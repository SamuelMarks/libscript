{
  "$schema": "../../_common/manifest.schema.json",
  "name": "questdb",
  "title": "QuestDB",
  "description": "High-throughput open-source time-series database with fast SQL, InfluxDB Line Protocol, and PostgreSQL wire support.",
  "category": "databases",
  "provides": ["questdb", "tsdb", "database"],
  "os_whitelist": ["all"],
  "ports": [9000, 8812],
  "stateful": true,
  "repository": "https://github.com/questdb/questdb",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
