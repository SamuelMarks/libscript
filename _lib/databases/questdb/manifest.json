{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "databases",
  "description": "High-throughput open-source time-series database with fast SQL, InfluxDB Line Protocol, and PostgreSQL wire support.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "questdb",
  "os_whitelist": ["all"],
  "ports": [9000, 8812],
  "provides": ["questdb", "tsdb", "database"],
  "repository": "https://github.com/questdb/questdb",
  "stateful": true,
  "tier": "T1",
  "title": "QuestDB"
}
