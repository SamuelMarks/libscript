{
  "$schema": "../../_common/manifest.schema.json",
  "name": "sqlite",
  "title": "SQLite",
  "description": "A C-language library that implements a small, fast, self-contained, high-reliability, full-featured, SQL database engine.",
  "category": "databases",
  "provides": ["database", "sqlite"],
  "conflicts": [],
  "os_whitelist": ["all"],
  "os_blacklist": [],
  "ports": [],
  "stateful": true,
  "multitenant": false,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
