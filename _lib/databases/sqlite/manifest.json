{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "sysroot-library"],
  "category": "databases",
  "conflicts": [],
  "description": "A C-language library that implements a small, fast, self-contained, high-reliability, full-featured, SQL database engine.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "memory_footprint_class": "mcu-sram-64k",
  "multitenant": false,
  "name": "sqlite",
  "os_blacklist": [],
  "os_whitelist": ["all"],
  "ports": [],
  "provides": ["database", "sqlite"],
  "rtos_support": ["zephyr", "freertos"],
  "stateful": true,
  "tier": "T1",
  "title": "SQLite"
}
