{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "databases",
  "description": "High-performance native graph database platform for connected data and Cypher query workloads.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "neo4j",
  "os_whitelist": ["all"],
  "ports": [7474, 7687],
  "provides": ["neo4j", "graph-database", "database"],
  "repository": "https://github.com/neo4j/neo4j",
  "stateful": true,
  "tier": "T1",
  "title": "Neo4j"
}
