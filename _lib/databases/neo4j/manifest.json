{
  "$schema": "../../_common/manifest.schema.json",
  "name": "neo4j",
  "title": "Neo4j",
  "description": "High-performance native graph database platform for connected data and Cypher query workloads.",
  "category": "databases",
  "provides": ["neo4j", "graph-database", "database"],
  "os_whitelist": ["all"],
  "ports": [7474, 7687],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/neo4j/neo4j",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
