{
  "$schema": "../../_common/manifest.schema.json",
  "name": "tidb",
  "title": "TiDB",
  "description": "Open-source distributed Hybrid Transactional and Analytical Processing (HTAP) SQL database compatible with MySQL.",
  "category": "database",
  "provides": ["tidb", "distributed-sql", "mysql-compatible", "database"],
  "os_whitelist": ["all"],
  "ports": [4000, 10080],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/pingcap/tidb",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
