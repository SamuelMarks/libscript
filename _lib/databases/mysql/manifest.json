{
  "$schema": "../../_common/manifest.schema.json",
  "name": "mysql",
  "title": "MySQL",
  "license": "GPL-2.0-only",
  "license_name": "GNU General Public License v2.0 only",
  "description": "MySQL 8.x relational database management system.",
  "category": "databases",
  "provides": ["database", "mysql", "rdbms", "sql"],
  "conflicts": [],
  "os_whitelist": ["all"],
  "os_blacklist": ["sunos"],
  "ports": [3306],
  "stateful": true,
  "multitenant": true,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
