{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "databases",
  "conflicts": [],
  "description": "MySQL 8.x relational database management system.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "license": "GPL-2.0-only",
  "license_name": "GNU General Public License v2.0 only",
  "multitenant": true,
  "name": "mysql",
  "os_blacklist": [],
  "os_whitelist": ["all"],
  "ports": [3306],
  "process_model": "single-process",
  "provides": ["database", "mysql", "rdbms", "sql"],
  "stateful": true,
  "tier": "T1",
  "title": "MySQL",
  "unikernel_support": ["osv", "nanos"]
}
