{
  "$schema": "../../_common/manifest.schema.json",
  "name": "duckdb",
  "title": "DuckDB",
  "description": "An in-process SQL OLAP database management system.",
  "category": "databases",
  "provides": ["duckdb"],
  "conflicts": [],
  "os_whitelist": ["all"],
  "os_blacklist": ["sunos"],
  "stateful": true,
  "multitenant": false,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
