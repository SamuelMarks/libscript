{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "sysroot-library"],
  "category": "databases",
  "conflicts": [],
  "description": "An in-process SQL OLAP database management system.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": false,
  "name": "duckdb",
  "os_blacklist": ["sunos"],
  "os_whitelist": ["all"],
  "provides": ["duckdb"],
  "stateful": true,
  "tier": "T1",
  "title": "DuckDB"
}
