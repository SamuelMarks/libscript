{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "databases",
  "conflicts": [],
  "description": "Centralized service for maintaining configuration information, naming, distributed synchronization, and quorum leader election.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": false,
  "name": "zookeeper",
  "os_blacklist": [],
  "os_whitelist": ["all"],
  "ports": [2181, 2888, 3888],
  "provides": ["zookeeper", "zk"],
  "stateful": true,
  "tier": "T1",
  "title": "Apache ZooKeeper",
  "versions": ["3.9.2", "3.8.4", "latest"]
}
