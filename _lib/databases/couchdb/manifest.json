{
  "$schema": "../../_common/manifest.schema.json",
  "name": "couchdb",
  "title": "Apache CouchDB",
  "description": "Seamless multi-master syncing document database with an intuitive HTTP/JSON API and reliability focus.",
  "category": "databases",
  "provides": ["couchdb", "document-store", "database"],
  "os_whitelist": ["all"],
  "ports": [5984],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/apache/couchdb",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
