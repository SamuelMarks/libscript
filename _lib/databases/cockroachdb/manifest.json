{
  "$schema": "../../_common/manifest.schema.json",
  "name": "cockroachdb",
  "title": "CockroachDB",
  "description": "Cloud-native distributed SQL database built for transactional consistency, horizontal scalability, and survivability.",
  "category": "databases",
  "provides": ["cockroachdb", "distributed-sql", "database"],
  "os_whitelist": ["all"],
  "ports": [26257, 8080],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/cockroachdb/cockroach",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
