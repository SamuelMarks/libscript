{
  "$schema": "../../_common/manifest.schema.json",
  "name": "postgres",
  "title": "PostgreSQL",
  "license": "PostgreSQL",
  "license_name": "The PostgreSQL License",
  "description": "A powerful, open source object-relational database system.",
  "category": "databases",
  "provides": ["database", "postgres", "postgresql"],
  "conflicts": [],
  "os_whitelist": ["all"],
  "os_blacklist": [],
  "ports": [5432],
  "stateful": true,
  "multitenant": true,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  },
  "repository": "https://github.com/postgres/postgres"
}
