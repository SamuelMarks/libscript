{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "databases",
  "conflicts": [],
  "description": "A powerful, open source object-relational database system.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "license": "PostgreSQL",
  "license_name": "The PostgreSQL License",
  "multitenant": true,
  "name": "postgres",
  "os_blacklist": [],
  "os_whitelist": ["all"],
  "ports": [5432],
  "process_model": "multiprocess-fork",
  "provides": ["database", "postgres", "postgresql", "rdbms", "sql"],
  "repository": "https://github.com/postgres/postgres",
  "stateful": true,
  "tier": "T1",
  "title": "PostgreSQL",
  "unikernel_support": ["osv", "nanos"]
}
