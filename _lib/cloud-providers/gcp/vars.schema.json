{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/_lib/cloud-providers/gcp/vars.schema.json",
  "title": "GCP Cloud Provider",
  "description": "GCP Cloud Provider management tools",
  "type": "object",
  "properties": {
    "GCP_PROJECT_ID": {
      "type": "string",
      "description": "GCP Project ID"
    },
    "GCP_REGION": {
      "type": "string",
      "default": "us-central1",
      "description": "GCP Region"
    },
    "GCP_ZONE": {
      "type": "string",
      "default": "us-central1-a",
      "description": "GCP Zone"
    },
    "GCP_INSTALL_METHOD": {
      "description": "How to install GCP. 'libscript_native' uses isolated version dirs, 'system' uses OS package manager, 'mise', 'asdf', 'pkgx', or 'vfox' defers to third-party tools.",
      "type": "string",
      "enum": ["libscript_native", "system", "mise", "asdf", "pkgx", "vfox"],
      "default": "libscript_native"
    }
  }
}
