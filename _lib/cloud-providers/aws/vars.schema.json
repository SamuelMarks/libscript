{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/_lib/cloud-providers/aws/vars.schema.json",
  "title": "AWS Cloud Provider",
  "description": "AWS Cloud Provider management tools",
  "type": "object",
  "properties": {
    "AWS_DEFAULT_REGION": {
      "type": "string",
      "default": "us-east-1",
      "description": "AWS Default Region"
    },
    "AWS_ACCESS_KEY_ID": {
      "type": "string",
      "description": "AWS Access Key ID"
    },
    "AWS_SECRET_ACCESS_KEY": {
      "type": "string",
      "description": "AWS Secret Access Key"
    },
    "AWS_INSTALL_METHOD": {
      "description": "How to install AWS. 'libscript_native' uses isolated version dirs, 'system' uses OS package manager, 'mise', 'asdf', 'pkgx', or 'vfox' defers to third-party tools.",
      "type": "string",
      "enum": ["libscript_native", "system", "mise", "asdf", "pkgx", "vfox"],
      "default": "libscript_native"
    }
  }
}
