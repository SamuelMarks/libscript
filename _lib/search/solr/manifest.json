{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "search",
  "description": "Open-source enterprise-grade search platform built on Apache Lucene with SolrCloud clustering.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "solr",
  "os_whitelist": ["all"],
  "ports": [8983],
  "provides": ["solr", "search"],
  "repository": "https://github.com/apache/solr",
  "stateful": true,
  "tier": "T1",
  "title": "Apache Solr"
}
