{
  "$schema": "../../_common/manifest.schema.json",
  "name": "solr",
  "title": "Apache Solr",
  "description": "Open-source enterprise-grade search platform built on Apache Lucene with SolrCloud clustering.",
  "category": "search",
  "provides": ["solr", "search"],
  "os_whitelist": ["all"],
  "ports": [8983],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/apache/solr",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
