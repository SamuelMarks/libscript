{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "search",
  "description": "Lightning-fast open-source typo-tolerant search engine optimized for instant sub-50ms search-as-you-type.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "typesense",
  "os_whitelist": ["all"],
  "ports": [8108],
  "provides": ["typesense", "search"],
  "repository": "https://github.com/typesense/typesense",
  "stateful": true,
  "tier": "T1",
  "title": "Typesense"
}
