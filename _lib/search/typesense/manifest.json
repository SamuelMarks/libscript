{
  "$schema": "../../_common/manifest.schema.json",
  "name": "typesense",
  "title": "Typesense",
  "description": "Lightning-fast open-source typo-tolerant search engine optimized for instant sub-50ms search-as-you-type.",
  "category": "search",
  "provides": ["typesense", "search"],
  "os_whitelist": ["all"],
  "ports": [8108],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/typesense/typesense",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
