{
  "$schema": "../../_common/manifest.schema.json",
  "name": "opensearch",
  "title": "OpenSearch",
  "description": "Community-driven Apache 2.0 distributed search, analytics, and vector database suite.",
  "category": "search",
  "provides": ["opensearch", "search"],
  "os_whitelist": ["all"],
  "ports": [9200, 9300],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/opensearch-project/OpenSearch",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
