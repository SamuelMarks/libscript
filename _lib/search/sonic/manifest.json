{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "search",
  "description": "Fast, lightweight, and schema-less search backend written in Rust as a minimal alternative to heavy search clusters.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "sonic",
  "os_whitelist": ["all"],
  "ports": [1491],
  "provides": ["sonic", "search"],
  "repository": "https://github.com/valeriansaliou/sonic",
  "stateful": true,
  "tier": "T1",
  "title": "Sonic"
}
