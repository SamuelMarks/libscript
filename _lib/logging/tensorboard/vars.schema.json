{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/_lib/logging/tensorboard/vars.schema.json",
  "title": "TensorBoard variables",
  "description": "Configuration variables for TensorBoard",
  "type": "object",
  "properties": {
    "TENSORBOARD_VERSION": {
      "description": "Specific version of TensorBoard to install.",
      "type": "string",
      "default": "latest",
      "version_aliases": ["latest", "stable"]
    },
    "TENSORBOARD_INSTALL_METHOD": {
      "description": "How to install TensorBoard.",
      "type": "string",
      "enum": ["libscript_native", "system"],
      "default": "libscript_native"
    },
    "TENSORBOARD_DOWNLOAD_URL": {
      "type": "string",
      "description": "Override URL for downloading tensorboard binary or archive artifacts."
    },
    "TENSORBOARD_RELEASES_URL": {
      "type": "string",
      "description": "Override URL for querying tensorboard available remote releases."
    }
  }
}
