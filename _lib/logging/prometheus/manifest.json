{
  "$schema": "../../_common/manifest.schema.json",
  "name": "prometheus",
  "title": "Prometheus",
  "description": "Cloud-native dimensional time-series monitoring server, PromQL query engine, and alerting toolkit.",
  "category": "logging",
  "provides": ["prometheus", "metrics-server", "observability"],
  "os_whitelist": ["all"],
  "ports": [9090],
  "repository": "https://github.com/prometheus/prometheus",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
