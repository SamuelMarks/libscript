{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "logging",
  "description": "Cloud-native dimensional time-series monitoring server, PromQL query engine, and alerting toolkit.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "prometheus",
  "os_whitelist": ["all"],
  "ports": [9090],
  "provides": ["prometheus", "metrics-server", "observability"],
  "repository": "https://github.com/prometheus/prometheus",
  "tier": "T1",
  "title": "Prometheus"
}
