{
  "$schema": "../../_common/manifest.schema.json",
  "name": "grafana",
  "title": "Grafana",
  "description": "Open-source analytics, interactive visualization, and alerting web platform for metrics, logs, and traces.",
  "category": "logging",
  "provides": ["grafana", "dashboards", "observability"],
  "os_whitelist": ["all"],
  "ports": [3000],
  "multitenant": true,
  "repository": "https://github.com/grafana/grafana",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
