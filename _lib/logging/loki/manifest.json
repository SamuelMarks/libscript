{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "logging",
  "description": "Horizontally scalable, highly available, multi-tenant log aggregation system inspired by Prometheus.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "loki",
  "os_whitelist": ["all"],
  "ports": [3100, 9096],
  "provides": ["loki", "log-aggregation", "observability"],
  "repository": "https://github.com/grafana/loki",
  "tier": "T1",
  "title": "Grafana Loki"
}
