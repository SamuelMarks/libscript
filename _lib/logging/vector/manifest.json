{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "logging",
  "description": "High-performance end-to-end observability data router and transformation pipeline built in Rust.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "vector",
  "os_whitelist": ["all"],
  "ports": [8686],
  "provides": ["vector", "log-shipper", "observability"],
  "repository": "https://github.com/vectordotdev/vector",
  "tier": "T1",
  "title": "Vector"
}
