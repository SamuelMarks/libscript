{
  "$schema": "../../_common/manifest.schema.json",
  "name": "vector",
  "title": "Vector",
  "description": "High-performance end-to-end observability data router and transformation pipeline built in Rust.",
  "category": "logging",
  "provides": ["vector", "log-shipper", "observability"],
  "os_whitelist": ["all"],
  "ports": [8686],
  "repository": "https://github.com/vectordotdev/vector",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
