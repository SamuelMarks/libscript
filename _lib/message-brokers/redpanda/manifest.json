{
  "$schema": "../../_common/manifest.schema.json",
  "name": "redpanda",
  "title": "Redpanda",
  "description": "C++ Kafka-compatible streaming data platform and rpk CLI engineered without JVM or ZooKeeper dependencies.",
  "category": "message-brokers",
  "provides": ["redpanda", "rpk", "kafka-compatible", "message-broker"],
  "os_whitelist": ["all"],
  "ports": [9092, 9644],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/redpanda-data/redpanda",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
