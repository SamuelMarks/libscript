{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "message-brokers",
  "description": "C++ Kafka-compatible streaming data platform and rpk CLI engineered without JVM or ZooKeeper dependencies.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "redpanda",
  "os_whitelist": ["all"],
  "ports": [9092, 9644],
  "provides": ["redpanda", "rpk", "kafka-compatible", "message-broker"],
  "repository": "https://github.com/redpanda-data/redpanda",
  "stateful": true,
  "tier": "T1",
  "title": "Redpanda"
}
