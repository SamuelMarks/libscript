{
  "$schema": "../../_common/manifest.schema.json",
  "name": "varnish",
  "title": "Varnish Cache",
  "description": "High-performance caching HTTP reverse proxy accelerator with flexible VCL policy configuration.",
  "category": "caches",
  "provides": ["varnish", "http-cache", "cache"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows"],
  "ports": [6081, 6082],
  "stateful": true,
  "repository": "https://github.com/varnishcache/varnish-cache",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
