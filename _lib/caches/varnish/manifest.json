{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "caches",
  "description": "High-performance caching HTTP reverse proxy accelerator with flexible VCL policy configuration.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "varnish",
  "os_blacklist": ["windows"],
  "os_whitelist": ["all"],
  "ports": [6081, 6082],
  "provides": ["varnish", "http-cache", "cache"],
  "repository": "https://github.com/varnishcache/varnish-cache",
  "stateful": true,
  "tier": "T1",
  "title": "Varnish Cache"
}
