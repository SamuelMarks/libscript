{
  "$schema": "../../_common/manifest.schema.json",
  "name": "keydb",
  "title": "KeyDB",
  "description": "High-performance multithreaded fork of Redis focusing on active-active replication and flash storage.",
  "category": "caches",
  "provides": ["keydb", "redis-compatible", "kv-store", "cache"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows", "sunos"],
  "ports": [6379],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/Snapchat/KeyDB",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
