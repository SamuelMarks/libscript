{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "caches",
  "description": "High-performance multithreaded fork of Redis focusing on active-active replication and flash storage.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "keydb",
  "os_blacklist": ["windows", "sunos"],
  "os_whitelist": ["all"],
  "ports": [6379],
  "provides": ["keydb", "redis-compatible", "kv-store", "cache"],
  "repository": "https://github.com/Snapchat/KeyDB",
  "stateful": true,
  "tier": "T1",
  "title": "KeyDB"
}
