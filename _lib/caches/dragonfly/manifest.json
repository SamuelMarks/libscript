{
  "$schema": "../../_common/manifest.schema.json",
  "name": "dragonfly",
  "title": "Dragonfly",
  "description": "Modern shared-nothing multithreaded in-memory data store compatible with Redis and Memcached protocols.",
  "category": "cache",
  "provides": ["dragonfly", "redis-compatible", "kv-store", "cache"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows", "sunos"],
  "ports": [6379],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/dragonflydb/dragonfly",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
