{
  "$schema": "../../_common/manifest.schema.json",
  "name": "valkey",
  "title": "Valkey",
  "license": "BSD-3-Clause",
  "license_name": "BSD 3-Clause 'New' or 'Revised' License",
  "description": "A high-performance, open-source, in-memory data store that is fully compatible with Redis.",
  "category": "cache",
  "provides": ["kv-store", "redis-compatible", "valkey", "cache"],
  "conflicts": ["redis"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows", "sunos"],
  "ports": [6379],
  "stateful": true,
  "multitenant": true,
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
