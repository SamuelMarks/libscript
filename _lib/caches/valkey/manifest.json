{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "caches",
  "conflicts": ["redis"],
  "description": "A high-performance, open-source, in-memory data store that is fully compatible with Redis.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "license": "BSD-3-Clause",
  "license_name": "BSD 3-Clause 'New' or 'Revised' License",
  "multitenant": true,
  "name": "valkey",
  "os_blacklist": ["windows"],
  "os_whitelist": ["all"],
  "ports": [6379],
  "process_model": "single-process",
  "provides": ["cache", "kv-store", "redis-compatible", "valkey"],
  "stateful": true,
  "tier": "T1",
  "title": "Valkey",
  "unikernel_support": ["unikraft", "nanos", "osv", "rumprun"]
}
