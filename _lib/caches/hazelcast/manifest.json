{
  "$schema": "../../_common/manifest.schema.json",
  "name": "hazelcast",
  "title": "Hazelcast",
  "description": "Distributed in-memory data grid and real-time stream processing platform.",
  "category": "caches",
  "provides": ["hazelcast", "data-grid", "cache"],
  "os_whitelist": ["all"],
  "ports": [5701],
  "stateful": true,
  "multitenant": true,
  "repository": "https://github.com/hazelcast/hazelcast",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
