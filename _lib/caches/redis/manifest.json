{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "caches",
  "conflicts": [],
  "description": "In-memory data structure store used as a database, cache, message broker, and streaming engine.",
  "hooks": {
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "license": "RSALv2 OR SSPL-1.0 OR AGPL-3.0-only",
  "license_name": "RSALv2 OR SSPL-1.0 OR AGPL-3.0-only (Redis 8+ Tri-License; 7.2 and prior BSD-3-Clause)",
  "multitenant": true,
  "name": "redis",
  "os_blacklist": [],
  "os_whitelist": ["all"],
  "ports": [6379],
  "process_model": "single-process",
  "provides": ["cache", "key-value", "kv-store", "redis"],
  "stateful": true,
  "tier": "T1",
  "title": "Redis",
  "unikernel_support": ["unikraft", "nanos", "osv", "rumprun"]
}
