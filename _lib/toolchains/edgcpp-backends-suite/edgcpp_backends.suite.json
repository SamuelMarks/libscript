    "warmup_runs": 1,
    "measured_trials": 11,
    "quantiles": [0.25, 0.5, 0.75, 0.99],
    "dispersion_metric": "median_and_stddev",
    "serialize_single_tu": true,
    "prng_seed": 2027
  },
  "compiler_pipelines": [
    {
      "id": "EDG-FE-ONLY",
      "manuscript_label": "cpfe Front-End Only (--no_code_gen)",
