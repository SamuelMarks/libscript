  "prereq_checks": [
    {
      "id": "gate_vmi_rtti_flags",
      "suites": ["E0", "E3"],
      "kind": "grep_absent",
      "target": "lib_src/gcc_be_eh_rt.c",
      "pattern": "base_count[[:space:]]*<=[[:space:]]*16",
      "description": "Verifies Itanium 2.9.5 __vmi_class_type_info::__flags bitmask support and removal of fixed base_count <= 16 cap."
    },
    {
      "id": "gate_deterministic_coro_frame",
      "suites": ["E0", "E4"],
      "kind": "grep_absent",
      "target": "src/gcc_gen_be_stmt.c",
      "pattern": "_Z_coro_frame_%p",
      "description": "Verifies deterministic _Z_coro_frame_%lu_%s naming without ASLR-sensitive pointer formatting and HALO stack soundness."
    },
    {
      "id": "gate_darwin_datalayout",
      "suites": ["E0", "E1", "E5"],
      "kind": "grep_present",
      "target": "src/llvm_gen_be_codegen.cpp",
      "pattern": "createDataLayout",
      "description": "Verifies clean target DataLayout emission without leaked x86/MSVC p270/p271/p272 address spaces."
    },
    {
      "id": "gate_external_declare_abi",
      "suites": ["E0", "E5"],
      "kind": "grep_present",
      "target": "src/llvm_gen_be_decl.cpp",
      "pattern": "llvm_compute_function_abi_info",
      "description": "Verifies AAPCS64/Darwin ARM64 >16B composite ABI classification on uncalled external declare prototypes."
    },
    {
      "id": "gate_o0_bool_lowering",
      "suites": ["E0", "E1"],
      "kind": "file_exists",
      "target": "src/llvm_gen_be_expr.cpp",
      "description": "Verifies streamlined -O0 i1 boolean branch lowering without redundant zext/icmp chains."
    },
    {
      "id": "gate_dynamic_deferred_structs",
      "suites": ["E0", "E5", "E6"],
      "kind": "grep_absent",
      "target": "src/gcc_gen_be_type.c",
      "pattern": "deferred_structs\\[4096\\]",
      "description": "Verifies realloc-grown deferred_structs array and full-width/big-endian/volatile bitfield RMW lowering."
    }
  ],
