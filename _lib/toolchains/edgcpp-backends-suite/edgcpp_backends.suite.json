      "stages": 1,
      "dialect_flags": ["--gnu_version=130200"]
    },
    {
      "id": "EDG-LLVM",
      "manuscript_label": "cpfe + llvm_gen_be",
      "backend_mode": "llvm",
      "stages": 1,
      "dialect_flags": ["--gnu_version=130200"],
      "matched_baseline_id": "NATIVE-CLANG",
      "required_env_vars": ["LLVM_PREFIX", "CLANG_MATCHED"]
    },
    {
      "id": "EDG-GCC",
      "manuscript_label": "cpfe + gcc_gen_be",
