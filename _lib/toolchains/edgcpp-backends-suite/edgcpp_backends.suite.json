      "dialect_flags": ["--gnu_version=130200"],
      "matched_baseline_id": "NATIVE-GCC",
      "runtime_libs": ["libedg.a"],
      "required_env_vars": ["GCC_PREFIX", "EDG_LIBGCCJIT_PATH", "GCC_MATCHED"]
    },
    {
      "id": "EDG-C-LEGACY",
      "manuscript_label": "Legacy c_gen_be (.int.c) + Clang",
      "backend_mode": "legacy_c",
      "stages": 2,
      "dialect_flags": ["--gnu_version=130200"],
      "matched_baseline_id": "NATIVE-CLANG",
      "runtime_libs": ["libedg.a"]
    },
    {
      "id": "EDG-CPP-LEGACY",
      "manuscript_label": "Legacy cp_gen_be (.int.cpp) + Clang++",
      "backend_mode": "legacy_cpp",
      "stages": 2,
      "dialect_flags": ["--gnu_version=130200"],
      "matched_baseline_id": "NATIVE-CLANG"
    },
    {
      "id": "NATIVE-CLANG",
      "manuscript_label": "Native Clang / Clang++",
      "backend_mode": "native_clang",
      "stages": 1
    },
    {
      "id": "NATIVE-GCC",
      "manuscript_label": "Native GCC / g++",
      "backend_mode": "native_gcc",
      "stages": 1
    }
  ],
