  "host_constraints": {
    "required_native_isas": [
      "macos_arm64",
      "linux_x64",
      "windows_x64",
      "freebsd_x64",
      "illumos_x64",
      "dos32_le"
    ],
    "forbid_binary_translation": true,
    "prepare_host": true,
    "drop_caches_on_cold": true,
    "cloud_sku_by_arch": {
      "linux_x64": "Standard_D160ads_v7",
      "macos_arm64": "mac2.metal",
      "windows_x64": "Standard_D32s_v5",
      "freebsd_x64": "bento/freebsd-15.1",
      "illumos_x64": "bento/omnios",
      "dos32_le": "anondos/msdos-4.0"
    }
  },
  "trial_policy": {
    "warmup_runs": 5,
    "measured_trials": 30,
    "quantiles": [0.25, 0.5, 0.75, 0.99],
    "dispersion_metric": "iqr_and_p99",
    "prng_seed": 202705
  },
  "build_profile": {
    "cargo_profile_flags": {
      "CARGO_PROFILE_RELEASE_OPT_LEVEL": "3",
      "CARGO_PROFILE_RELEASE_LTO": "thin",
      "CARGO_PROFILE_RELEASE_CODEGEN_UNITS": "1"
    },
    "cargo_forbid_unsafe": true,
    "workspace_bins": [
      "cdd-c-transform",
      "wincmd",
      "wincheck",
      "msi-cli",
      "msiexec",
      "candle",
      "light",
      "wix",
      "dark",
      "smoke"
    ],
    "c_compiler_flags": ["-std=c11", "-O3"],
    "c89_strict_flags": [
      "-std=c89",
      "-Wdeclaration-after-statement",
      "-Wall",
      "-Wextra",
      "-pedantic",
      "-Werror"
    ],
    "posix_opt_flags": ["-O3", "-DNDEBUG"],
    "msvc_flags": ["/O2", "/DNDEBUG", "/W4"],
    "msvc_crt_variants": ["MT", "MD"],
    "openwatcom_dos32_flags": ["-bt=dos", "-mf", "-3r", "-ox"],
    "msi_validation_modes": [
      "ice_105_default",
      "sval_0_ice",
      "smoke_standalone_105",
      "darice_cub_oracle"
    ],
    "strip_mode": "strip-unneeded"
  },
  "prereq_checks": [
    {
      "id": "awm_use_cdd_c",
      "repo_id": "auto-win-msvc",
      "suites": ["E1", "E2"],
      "kind": "grep_present",
      "target": "cmake/AutoWinMsvcTransform.cmake",
      "pattern": "AUTO_WIN_MSVC_USE_CDD_C",
      "description": "Ensure AutoWinMsvcTransform.cmake invokes cdd-c-transform."
    },
    {
      "id": "wincmd_packrat_keys",
      "repo_id": "win-cmd-rs",
      "suites": ["E5"],
      "kind": "grep_present",
      "target": "src/parser/peg.rs",
      "pattern": "CompoundBlock|IfStmt|ForStmt",
      "description": "Ensure PegRuleKey memoizes nested block nonterminals for linear O(n) Packrat parsing."
    },
    {
      "id": "msi_affine_drop_guard",
      "repo_id": "msi-rs",
      "suites": ["E4"],
      "kind": "grep_present",
      "target": "crates/msi/src/execution/transaction/mod.rs",
      "pattern": "armed",
      "description": "Ensure Transaction<Executed> enforces affine Drop and worker-EOF LIFO rollback."
    }
  ],
