{
  "$schema": "../../../experiment-suite.schema.json",
  "id": "win_port",
  "title": "win_port 14-Repository Empirical Evaluation & Zero-Hallucination Benchmarking Protocol (E0-E7)",
  "protocol_version": "PLDI-2027-win-port-v1",
  "manuscript_dir": "../new_research/win_port",
  "manuscript_tex": "win_port_paper.tex",
