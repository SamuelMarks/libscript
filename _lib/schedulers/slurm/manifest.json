{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "schedulers",
  "conflicts": [],
  "description": "Fault-tolerant, highly scalable cluster management and job scheduling system for HPC and AI training clusters.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "multitenant": true,
  "name": "slurm",
  "os_blacklist": [],
  "os_whitelist": ["all"],
  "ports": [6817, 6818],
  "provides": ["slurm", "sbatch", "srun", "squeue", "scancel", "slurmctld", "slurmd"],
  "stateful": true,
  "tier": "T1",
  "title": "Slurm Workload Manager",
  "versions": ["24.05.3", "23.11.9", "latest"]
}
