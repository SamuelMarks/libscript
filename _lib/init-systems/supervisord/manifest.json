{
  "$schema": "../../_common/manifest.schema.json",
  "name": "supervisord",
  "title": "Supervisor Process Control System",
  "description": "Supervisor client/server process control daemon (supervisord and supervisorctl) for UNIX-like operating systems.",
  "category": "init-systems",
  "provides": ["supervisord", "supervisor", "supervisorctl"],
  "os_whitelist": ["linux", "macos", "freebsd", "openbsd", "netbsd", "sunos"],
  "os_blacklist": ["windows"],
  "ports": [9001],
  "repository": "https://github.com/Supervisor/supervisor",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
