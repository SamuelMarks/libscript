{
  "$schema": "../../_common/manifest.schema.json",
  "name": "fail2ban",
  "title": "Fail2ban",
  "description": "Log-scanning intrusion prevention daemon that bans malicious hosts exhibiting brute-force patterns.",
  "category": "security",
  "provides": ["fail2ban", "ips", "security"],
  "os_whitelist": ["all"],
  "os_blacklist": ["windows"],
  "repository": "https://github.com/fail2ban/fail2ban",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
