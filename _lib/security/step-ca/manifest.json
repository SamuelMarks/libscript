{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "security",
  "description": "Private online X.509 and SSH certificate authority server supporting automated ACME certificate issuance.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "step-ca",
  "os_whitelist": ["all"],
  "ports": [9000],
  "provides": ["step-ca", "certificate-authority", "acme"],
  "repository": "https://github.com/smallstep/certificates",
  "tier": "T1",
  "title": "Smallstep step-ca"
}
