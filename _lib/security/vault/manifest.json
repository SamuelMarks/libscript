{
  "$schema": "../../_common/manifest.schema.json",
  "name": "vault",
  "title": "HashiCorp Vault",
  "description": "Identity-based secrets management, dynamic credentials, and encryption-as-a-service server.",
  "category": "security",
  "provides": ["vault", "secrets-manager"],
  "os_whitelist": ["all"],
  "ports": [8200, 8201],
  "multitenant": true,
  "repository": "https://github.com/hashicorp/vault",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
