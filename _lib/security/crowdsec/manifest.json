{
  "$schema": "../../../engine/schemas/manifest.schema.json",
  "capabilities": ["userland-package", "service-daemon"],
  "category": "security",
  "description": "Collaborative, open-source intrusion prevention and behavioral threat intelligence security engine.",
  "hooks": {
    "logical": [],
    "metrics_scrape_path": "/metrics",
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "probe_timeout_seconds": 30
  },
  "name": "crowdsec",
  "os_whitelist": ["all"],
  "ports": [8080, 6060],
  "provides": ["crowdsec", "ips", "security"],
  "repository": "https://github.com/crowdsecurity/crowdsec",
  "tier": "T1",
  "title": "CrowdSec"
}
