{
  "$schema": "../../_common/manifest.schema.json",
  "name": "crowdsec",
  "title": "CrowdSec",
  "description": "Collaborative, open-source intrusion prevention and behavioral threat intelligence security engine.",
  "category": "security",
  "provides": ["crowdsec", "ips", "security"],
  "os_whitelist": ["all"],
  "ports": [8080, 6060],
  "repository": "https://github.com/crowdsecurity/crowdsec",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": [],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
