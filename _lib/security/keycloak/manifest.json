{
  "$schema": "../../_common/manifest.schema.json",
  "name": "keycloak",
  "title": "Keycloak",
  "description": "Open-source Identity and Access Management server supporting OpenID Connect, OAuth 2.0, and SAML 2.0.",
  "category": "security",
  "provides": ["keycloak", "iam", "oidc", "saml"],
  "os_whitelist": ["all"],
  "ports": [8080, 8443],
  "multitenant": true,
  "repository": "https://github.com/keycloak/keycloak",
  "hooks": {
    "physical": [
      "configure",
      "probe",
      "announce",
      "log_stream",
      "metrics",
      "backup",
      "restore",
      "upgrade",
      "rollback",
      "maintenance"
    ],
    "logical": ["provision_tenant", "deprovision_tenant", "backup_tenant", "restore_tenant"],
    "probe_timeout_seconds": 30,
    "metrics_scrape_path": "/metrics"
  }
}
