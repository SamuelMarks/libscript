{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/_lib/_common/base_vars.schema.json",
  "title": "LibScript Base Component Variables",
  "description": "Common variables shared by all LibScript components",
  "type": "object",
  "properties": {
    "LIBSCRIPT_DEFAULT_INSTALL_METHOD": {
      "description": "Global override for how software should be installed (system vs libscript_native).",
      "type": "string",
      "enum": ["libscript_native", "system", "mise", "asdf", "pkgx", "vfox"],
      "default": "libscript_native"
    },
    "LIBSCRIPT_WINDOWS_PKG_MGR": {
      "description": "Global package manager override for Windows (winget, choco).",
      "type": "string",
      "enum": ["winget", "choco"],
      "default": "winget"
    },
    "LIBSCRIPT_LOG_LEVEL": {
      "type": "string",
      "description": "Minimum logging level (0=DEBUG, 1=INFO, 2=SUCCESS, 3=WARN, 4=ERROR).",
      "default": "1"
    },
    "LIBSCRIPT_LOG_FORMAT": {
      "type": "string",
      "description": "Output format for logs (text, json).",
      "enum": ["text", "json"],
      "default": "text"
    },
    "LIBSCRIPT_LOG_FILE": {
      "type": "string",
      "description": "File to write logs to (in addition to standard output)."
    },
    "LIBSCRIPT_SERVICE_NAME": {
      "type": "string",
      "description": "Overrides the default service name."
    },
    "DOWNLOAD_DIR": {
      "type": "string",
      "description": "Directory where downloads are stored."
    },
    "FORMAT": {
      "type": "string",
      "description": "Output format (e.g., json, text)."
    },
    "LIBSCRIPT_CACHE_DIR": {
      "type": "string",
      "description": "Directory where cached files are stored."
    },
    "LIBSCRIPT_LOG_DRIVER": {
      "type": "string",
      "description": "Logging driver to use (e.g., fluentd)."
    },
    "LOGS_DIR": {
      "type": "string",
      "description": "Directory where logs should be stored."
    },
    "VAULT_TOKEN": {
      "type": "string",
      "description": "Token for HashiCorp Vault authentication."
    },
    "PREFIX": {
      "type": "string",
      "description": "Installation prefix."
    },
    "SERVE_FROM": {
      "type": "string",
      "description": "Base directory or context path for the service."
    },
    "LIBSCRIPT_LOG_HOST": {
      "type": "string",
      "description": "Host for remote logging."
    },
    "LIBSCRIPT_VERSION": {
      "type": "string",
      "description": "Specifies the version of the package to use."
    },
    "LIBSCRIPT_LOG_PORT": {
      "type": "string",
      "description": "Port for remote logging."
    },
    "TPU_ZONE": {
      "type": "string",
      "description": "GCP Zone for TPU provisioning",
      "default": "us-central2-b"
    },
    "TPU_ACCELERATOR_TYPE": {
      "type": "string",
      "description": "Type of TPU accelerator (e.g. v4-8)",
      "default": "v4-8"
    },
    "TPU_VERSION": {
      "type": "string",
      "description": "TPU VM OS version",
      "default": "tpu-ubuntu2204-base"
    },
    "GCP_PROJECT_ID": {
      "type": "string",
      "description": "GCP Project ID"
    },
    "XPK_CLUSTER_NAME": {
      "type": "string",
      "description": "Name for the XPK GKE cluster"
    },
    "TPU_TENSOR_PARALLEL_SIZE": {
      "type": "string",
      "description": "Tensor parallel size for TPU serving",
      "default": "1"
    },
    "MODEL_NAME": {
      "type": "string",
      "description": "HuggingFace model string to serve",
      "default": "your-org/your-model-name"
    },
    "WORKLOAD_NAME": {
      "type": "string",
      "description": "Name of the XPK workload"
    },
    "JETSTREAM_IMAGE": {
      "type": "string",
      "description": "Docker image for JetStream TPU inference"
    }
  }
}
