@echo off
:: # wattcp_cfg.cmd
::
:: ## Overview
:: Idempotently synthesizes `WATTCP.CFG` for **Watt-32** Crynwr packet-driver networking
:: (`ne2k_isa`, `pcnet`, FreeDOS, MS-DOS 6.22) when online downloads run on `IS_MSDOS=1`,
:: while completely bypassing packet-driver setup when `LIBSCRIPT_OFFLINE=1` (`--offline`).
::
:: ## Usage
:: call "%LIBSCRIPT_ROOT_DIR%\_lib\_common\dos32\wattcp_cfg.cmd"

setlocal EnableDelayedExpansion
set "THIS_FILE=%~f0"

if defined STACK (
    echo "!STACK!" | findstr /I /C:":!THIS_FILE!:" >nul 2>&1
    if not errorlevel 1 (
        echo [STOP] processing "!THIS_FILE!" >&2
        exit /b 0
    )
)
set "STACK=%STACK%:!THIS_FILE!:"

set "SCRIPT_DIR=%~dp0"
if "%SCRIPT_DIR:~-1%"=="\" set "SCRIPT_DIR=%SCRIPT_DIR:~0,-1%"

if not defined LIBSCRIPT_ROOT_DIR (
    set "d=!SCRIPT_DIR!"
    call :find_root
)
goto :root_found

:: ## find_root
:: Ascends the directory tree looking for ROOT or libscript.cmd.
:find_root
if exist "!d!\libscript.cmd" (
    set "LIBSCRIPT_ROOT_DIR=!d!"
    exit /b 0
)
if exist "!d!\ROOT" (
    set "LIBSCRIPT_ROOT_DIR=!d!"
    exit /b 0
)
for %%P in ("!d!") do set "parent=%%~dpP"
set "d=!parent:~0,-1!"
if "!d!"=="" (
    echo Error: Could not find LIBSCRIPT_ROOT_DIR 1>&2
    exit /b 1
)
goto :find_root

:: ## root_found
:: Continues execution once LIBSCRIPT_ROOT_DIR is verified.
:root_found

if "%LIBSCRIPT_OFFLINE%"=="1" exit /b 0

set "_WC_HOME=%LIBSCRIPT_HOME%"
if "!_WC_HOME!"=="" set "_WC_HOME=C:\LIBSCRIP"
set "_WC_DIR=%WATTCP_CFG_DIR%"
if "!_WC_DIR!"=="" set "_WC_DIR=!_WC_HOME!\ETC"
set "_WC_FILE=%WATTCP_CFG_FILE%"
if "!_WC_FILE!"=="" set "_WC_FILE=!_WC_DIR!\WATTCP.CFG"
if not exist "!_WC_DIR!" mkdir "!_WC_DIR!" 2>nul

set "_WC_MODE=%LIBSCRIPT_DOS_NET_MODE%"
if "!_WC_MODE!"=="" set "_WC_MODE=dhcp"
set "_WC_VEC=%LIBSCRIPT_DOS_PKT_VEC%"
if "!_WC_VEC!"=="" set "_WC_VEC=0x60"
set "_WC_DNS=%LIBSCRIPT_DOS_NAMESERVER%"
if "!_WC_DNS!"=="" set "_WC_DNS=10.0.2.3"
set "_WC_MTU=%LIBSCRIPT_DOS_MTU%"
if "!_WC_MTU!"=="" set "_WC_MTU=1500"

if /i "!_WC_MODE!"=="static" (
    set "_WC_IP=%LIBSCRIPT_DOS_IP%"
    if "!_WC_IP!"=="" set "_WC_IP=10.0.2.15"
    set "_WC_MASK=%LIBSCRIPT_DOS_NETMASK%"
    if "!_WC_MASK!"=="" set "_WC_MASK=255.255.255.0"
    set "_WC_GW=%LIBSCRIPT_DOS_GATEWAY%"
    if "!_WC_GW!"=="" set "_WC_GW=10.0.2.2"
    (
        echo # Generated by LibScript Watt-32 packet-driver configurator ^(static mode^)
        echo pkt.vector = !_WC_VEC!
        echo my_ip = !_WC_IP!
        echo netmask = !_WC_MASK!
        echo gateway = !_WC_GW!
        echo nameserver = !_WC_DNS!
        echo mtu = !_WC_MTU!
        echo sockdelay = 30
    ) > "!_WC_FILE!.TMP"
) else (
    (
        echo # Generated by LibScript Watt-32 packet-driver configurator ^(DHCP mode^)
        echo pkt.vector = !_WC_VEC!
        echo my_ip = dhcp
        echo nameserver = !_WC_DNS!
        echo mtu = !_WC_MTU!
        echo dhcp.req_list = 1,3,6,15
        echo sockdelay = 30
    ) > "!_WC_FILE!.TMP"
)
move /y "!_WC_FILE!.TMP" "!_WC_FILE!" >nul
echo !_WC_FILE!
endlocal & set "WATTCP.CFG=%_WC_DIR%" & set "WATTCP_CFG=%_WC_DIR%"
exit /b 0
