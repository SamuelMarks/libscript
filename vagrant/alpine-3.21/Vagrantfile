# -*- mode: ruby -*-
# vi: set ft=ruby :

# All Vagrant configuration is done below. The "2" in Vagrant.configure
# configures the configuration version (we support older styles for
# backwards compatibility). Please don't change it unless you know what
# you're doing.
Vagrant.configure("2") do |config|
  # Determine number of nodes to start, defaults to 1 if VAGRANT_N is unset
  node_count = ENV.fetch('VAGRANT_N', 1).to_i
  box_name = "alpine-standard-3.21.3"

  if node_count == 1
    # Legacy single-node behavior
    config.vm.box = box_name
    config.vm.synced_folder ".", "/vagrant", disabled: true
  else
    # Multi-node deployment for testing distributed configurations (e.g., k8s-thw)
    # Allows scripts like up_multiple.sh to provision alpine-3.210, alpine-3.211, etc.
    (0...node_count).each do |i|
      config.vm.define "alpine-3.21#{i}" do |node|
        node.vm.box = box_name
        node.vm.hostname = "node-#{i}"
        node.vm.network "private_network", ip: "192.168.56.#{10 + i}"
        node.vm.synced_folder ".", "/vagrant", disabled: true
      end
    end
  end
end
