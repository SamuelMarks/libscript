# -*- mode: ruby -*-
# vi: set ft=ruby :
# ## Overview
# FreeDOS 1.4 (`bento/freedos-1.4`) Vagrant configuration using `../bento`'s
# `Bento::VagrantFreedos` (`:freedos` communicator over Telnet/Serial `COM1` + bidirectional
# `:freedos_sync` `D:` drive) and `DOS4GW.EXE` / `DOS32A.EXE` for 16-bit and 32-bit DOS testing.
#
# ## Usage
# cd vagrant/freedos-1.4 && vagrant up

require "rbconfig"

bento_freedos_loaded = false
begin
  require "bento/vagrant_freedos"
  bento_freedos_loaded = true
rescue LoadError
  [ENV["BENTO_DIR"], File.expand_path("../../../bento", __dir__)].compact.each do |cand|
    bento_lib = File.join(cand, "lib")
    if File.directory?(bento_lib) && !$LOAD_PATH.include?(bento_lib)
      $LOAD_PATH.unshift(bento_lib)
    end
  end
  begin
    require "bento/vagrant_freedos"
    bento_freedos_loaded = true
  rescue LoadError
    bento_freedos_loaded = false
  end
end

Vagrant.configure("2") do |config|
  if bento_freedos_loaded
    config.vm.guest = :freedos
    config.vm.communicator = :freedos
  end
  config.vm.allow_fstab_modification = false
  config.ssh.insert_key = false

  config.vm.define "freedos-1.4-ctest" do |dos|
    box_prefix = ENV["BENTO_PREFIX"] || "bento"
    serial_port = (ENV["FREEDOS_SERIAL_PORT"] || 2323).to_i

    dos.vm.box = "#{box_prefix}/freedos-1.4"
    dos.vm.allow_fstab_modification = false
    dos.ssh.insert_key = false

    if bento_freedos_loaded
      dos.vm.guest = :freedos
      dos.vm.communicator = :freedos
      if dos.respond_to?(:freedos)
        dos.freedos.host = "127.0.0.1"
        dos.freedos.port = serial_port
        dos.freedos.sync_drive = "D:"
        dos.freedos.work_dir = "D:"
      end
      dos.vm.synced_folder ".", "/vagrant",
        type: :freedos_sync,
        drive: "D:",
        sync_direction: :bidirectional,
        crlf_convert: true,
        exclude: [".git/", ".vagrant/", "builds/", "tests_tmp/", "vagrant/"]
    else
      dos.vm.communicator = :msdos_com1 if Vagrant.has_plugin?("vagrant-msdos")
      dos.vm.synced_folder ".", "/vagrant", disabled: true
    end

    dos.vm.provider :qemu do |qe|
      host_cpu = RbConfig::CONFIG["host_cpu"].to_s.downcase
      is_arm = host_cpu.include?("arm") || host_cpu.include?("aarch64")
      is_win = RUBY_PLATFORM =~ /mswin|mingw|cygwin/
      accel = is_arm ? "tcg" : (RUBY_PLATFORM.include?("darwin") ? "hvf:tcg" : (is_win ? "whpx:tcg" : "kvm:tcg"))

      qe.arch = "i386" if qe.respond_to?(:arch=)
      qe.machine = "pc,accel=#{accel}" if qe.respond_to?(:machine=)
      qe.cpu = (is_arm ? "max" : "pentium2") if qe.respond_to?(:cpu=)
      qe.smp = "1" if qe.respond_to?(:smp=)
      qe.memory = "64M" if qe.respond_to?(:memory=)
      qe.net_device = "pcnet" if qe.respond_to?(:net_device=)
      qe.drive_interface = "ide" if qe.respond_to?(:drive_interface=)
      qe.firmware_format = nil if qe.respond_to?(:firmware_format=)
      if qe.respond_to?(:extra_qemu_args=)
        qe.extra_qemu_args = [
          "-vga", "std",
          "-rtc", "base=localtime",
          "-serial", "telnet:127.0.0.1:#{serial_port},server,nowait"
        ]
      end
    end

    dos.vm.provider :virtualbox do |vb|
      vb.memory = 64
      vb.cpus = 1
      vb.check_guest_additions = false if vb.respond_to?(:check_guest_additions=)
      vb.customize ["modifyvm", :id, "--uart1", "0x3f8", "4"]
      vb.customize ["modifyvm", :id, "--uartmode1", "tcpserver", serial_port.to_s]
    end
  end
end
