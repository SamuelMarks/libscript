{
  "$schema": "../topology.schema.json",
  "name": "valkey-cluster",
  "version": "1.0.0",
  "description": "Distributed Valkey cluster with 16384 hash slot sharding, replica auto-failover, and WireGuard mesh peering.",
  "quorum_strategy": "cluster-gossip",
  "fencing_policy": "firewall-isolate",
  "node_groups": [
    {
      "name": "valkey-primaries",
      "provider": "gcp",
      "region": "us-central1-a",
      "size": "n2-standard-4",
      "count": 3,
      "role": "leader",
      "components": ["caches/valkey"],
      "traits": ["storage", "secrets", "mesh", "firewall", "discovery", "backup"]
    },
    {
      "name": "valkey-replicas",
      "provider": "gcp",
      "region": "us-central1-b",
      "size": "n2-standard-4",
      "count": 3,
      "role": "follower",
      "components": ["caches/valkey"],
      "traits": ["storage", "secrets", "mesh", "firewall", "discovery", "backup"]
    }
  ],
  "network": {
    "vpc_cidr": "10.43.0.0/16",
    "mesh_overlay": "wireguard",
    "internal_domain": "valkey.internal"
  }
}
