{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/stacks/erp/odoo/vars.schema.json",
  "title": "odoo vars",
  "description": "Variables for odoo vars",
  "type": "object",
  "properties": {
    "ODOO_DB_TYPE": {
      "type": "string",
      "description": "Variable ODOO_DB_TYPE."
    },
    "ODOO_LISTEN": {
      "type": "string",
      "description": "Variable ODOO_LISTEN."
    },
    "ODOO_VERSION": {
      "type": "string",
      "description": "Variable ODOO_VERSION."
    },
    "ODOO_DB_USER": {
      "type": "string",
      "description": "Variable ODOO_DB_USER."
    },
    "ODOO_DB_HOST": {
      "type": "string",
      "description": "Variable ODOO_DB_HOST."
    },
    "ODOO_WEBSERVER": {
      "type": "string",
      "description": "Variable ODOO_WEBSERVER."
    },
    "ODOO_WWWROOT": {
      "type": "string",
      "description": "Variable WWWROOT."
    },
    "ODOO_SERVER_NAME": {
      "type": "string",
      "description": "Variable ODOO_SERVER_NAME."
    },
    "ODOO_DB_NAME": {
      "type": "string",
      "description": "Variable ODOO_DB_NAME."
    },
    "ODOO_DB_PASS": {
      "type": "string",
      "description": "Variable ODOO_DB_PASS."
    },
    "ODOO_DB_PORT": {
      "type": "string",
      "description": "Variable ODOO_DB_PORT."
    },
    "ODOO_PORT": {
      "type": "string",
      "description": "Variable ODOO_PORT."
    },
    "db_strategy": {
      "type": "string",
      "enum": ["local", "remote"],
      "default": "local",
      "description": "Database provisioning strategy (e.g. relational vs nosql)."
    },
    "db_host": {
      "type": "string",
      "default": "127.0.0.1",
      "description": "Database connection host."
    },
    "db_name": {
      "type": "string",
      "default": "odoo",
      "description": "Database name."
    },
    "db_url": {
      "type": "string",
      "description": "Full database connection string or URL."
    }
  }
}
