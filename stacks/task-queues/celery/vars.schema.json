{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/stacks/task-queues/celery/vars.schema.json",
  "title": "celery storage vars",
  "description": "Variables for celery storage vars",
  "type": "object",
  "properties": {
    "CELERY_SERVICE_USER": {
      "type": "string",
      "description": "User account used to run the Celery worker daemon.",
      "default": "celery"
    },
    "CELERY_APP": {
      "type": "string",
      "description": "Celery application module (e.g., 'lms.envs.tutor.production')."
    },
    "CELERY_QUEUES": {
      "type": "string",
      "description": "Comma-separated list of queues to consume from.",
      "default": "high,default,low"
    },
    "CELERY_CONCURRENCY": {
      "type": ["integer", "string"],
      "description": "Number of concurrent worker child processes.",
      "default": 2
    },
    "CELERY_BEAT_ENABLED": {
      "type": "boolean",
      "description": "Whether to run Celery Beat periodic scheduler.",
      "default": false
    },
    "CELERY_BROKER_URL": {
      "type": "string",
      "description": "Broker URL for Celery (e.g. redis://127.0.0.1:6379/0)."
    },
    "PYTHON_VENV": {
      "description": "Python virtualenv to install & then start the celery daemon from",
      "type": "string"
    },
    "PREFIX": {
      "type": "string",
      "description": "Installation prefix."
    },
    "LIBSCRIPT_LOG_DRIVER": {
      "type": "string",
      "description": "Logging driver to use (e.g., fluentd)."
    },
    "LIBSCRIPT_LOG_HOST": {
      "type": "string",
      "description": "Host for remote logging."
    },
    "GROUP": {
      "type": "string",
      "description": "Variable GROUP."
    },
    "LIBSCRIPT_LOG_PORT": {
      "type": "string",
      "description": "Port for remote logging."
    },
    "PYTHON_VERSION": {
      "type": "string",
      "description": "Variable PYTHON_VERSION."
    },
    "FORMAT": {
      "type": "string",
      "description": "Output format (e.g., json, text)."
    },
    "LOGS_DIR": {
      "type": "string",
      "description": "Directory where logs should be stored."
    },
    "SERVE_FROM": {
      "type": "string",
      "description": "Base directory or context path from which the service should be served."
    },
    "LIBSCRIPT_VERSION": {
      "type": "string",
      "description": "Specifies the version of the package to use."
    },
    "VAULT_TOKEN": {
      "type": "string",
      "description": "Token for HashiCorp Vault authentication."
    },
    "LIBSCRIPT_SERVICE_NAME": {
      "type": "string",
      "description": "Overrides the default service name."
    }
  }
}
