{
  "$schema": "../../../packaging/packaging.schema.json",
  "name": "openedx",
  "title": "Open edX Platform",
  "version": "22.1.0",
  "publisher": "The Axim Collaborative & LibScript Contributors",
  "upgrade_code": "B8C8E64E-9B5A-4B7C-A5D8-0F18B9918239",
  "topology": "suite_orchestrator",
  "database_contract": {
    "engine": "mysql",
    "min_version": "8.0",
    "allow_shared_instance": true,
    "default_schema_name": "openedx",
    "default_user_name": "openedx",
    "default_port": 3306,
    "character_set": "utf8mb4",
    "collation": "utf8mb4_unicode_ci",
    "ssl_required": false,
    "dbaas_supported": true
  },
  "branding_palette": {
    "primary_color": "#00263E",
    "secondary_color": "#0075B4",
    "dark_color": "#0A192F",
    "app_title": "Open edX Platform",
    "eula_components": [
      "Open edX Platform",
      "MySQL Relational Database",
      "Redis Cache",
      "MongoDB Datastore"
    ]
  },
  "chained_packages": [
    {
      "id": "mysql",
      "component": "_lib/databases/mysql",
      "upgrade_code": "E0F45901-83B4-4B21-9B5A-01D38FE81001",
      "install_condition": "INSTALL_MYSQL=\"1\"",
      "property_forwarding": { "PROP_MYSQL_PORT": "PORT" }
    },
    {
      "id": "redis",
      "component": "_lib/caches/redis",
      "upgrade_code": "E0F45901-83B4-4B21-9B5A-01D38FE81002",
      "install_condition": "INSTALL_REDIS=\"1\"",
      "property_forwarding": { "PROP_REDIS_PORT": "PORT" }
    },
    {
      "id": "mongodb",
      "component": "_lib/databases/mongodb",
      "upgrade_code": "E0F45901-83B4-4B21-9B5A-01D38FE81003",
      "install_condition": "INSTALL_MONGODB=\"1\"",
      "property_forwarding": { "PROP_MONGODB_PORT": "PORT" }
    }
  ],
  "branding": {
    "icon": "packaging/assets/openedx.ico",
    "banner_top": "packaging/assets/openedx_banner_top.bmp",
    "banner_side": "packaging/assets/openedx_banner_side.bmp",
    "license_rtf": "packaging/assets/openedx_eula.rtf",
    "license_mode": "consolidated_eula",
    "require_all_accepted": true,
    "bundled_licenses": [
      {
        "component": "openedx",
        "title": "Open edX Platform",
        "spdx_id": "AGPL-3.0-only",
        "mandatory": true
      },
      {
        "component": "mysql",
        "title": "MySQL Relational Database",
        "spdx_id": "GPL-2.0-only",
        "mandatory": true
      },
      {
        "component": "redis",
        "title": "Redis In-Memory Cache & Broker",
        "spdx_id": "RSALv2 OR SSPL-1.0 OR AGPL-3.0-only",
        "mandatory": true
      },
      {
        "component": "mongodb",
        "title": "MongoDB Document Datastore",
        "spdx_id": "SSPL-1.0",
        "mandatory": true
      },
      {
        "component": "python",
        "title": "Python Language Runtime",
        "spdx_id": "Python-2.0",
        "mandatory": true
      },
      {
        "component": "nodejs",
        "title": "Node.js JavaScript Runtime",
        "spdx_id": "MIT",
        "mandatory": true
      },
      {
        "component": "meilisearch",
        "title": "Meilisearch Full-Text Search Engine",
        "spdx_id": "MIT",
        "mandatory": true
      },
      {
        "component": "gunicorn",
        "title": "Gunicorn WSGI Application Server",
        "spdx_id": "MIT",
        "mandatory": true
      },
      {
        "component": "hmailserver",
        "title": "hMailServer SMTP Relay",
        "spdx_id": "AGPL-3.0-only",
        "mandatory": true
      },
      {
        "component": "nodeenv",
        "title": "Nodeenv Virtual Environment Manager",
        "spdx_id": "BSD-3-Clause",
        "mandatory": true
      }
    ]
  },
  "directories": {
    "app_default": "[ProgramFiles64Folder]OpenEdX",
    "data_default": "C:\\ProgramData\\OpenEdX\\data",
    "logs_default": "C:\\ProgramData\\OpenEdX\\logs",
    "backups_default": "C:\\ProgramData\\OpenEdX\\backups"
  },
  "runtime_searches": [
    {
      "name": "python",
      "title": "Python 3.11+ Execution Runtime",
      "required": true,
      "registry_searches": [
        {
          "root": "HKLM",
          "key": "SOFTWARE\\Python\\PythonCore\\3.12\\InstallPath",
          "file": "python.exe"
        },
        {
          "root": "HKLM",
          "key": "SOFTWARE\\Python\\PythonCore\\3.11\\InstallPath",
          "file": "python.exe"
        }
      ],
      "path_command": "python.exe",
      "version_regex": "3\\.(1[0-9]|[2-9][0-9])"
    },
    {
      "name": "nodejs",
      "title": "Node.js 18/20+ Asset Pipeline Runtime",
      "required": true,
      "registry_searches": [
        {
          "root": "HKLM",
          "key": "SOFTWARE\\Node.js",
          "name": "InstallPath",
          "file": "node.exe"
        }
      ],
      "path_command": "node.exe",
      "version_regex": "v(1[8-9]|[2-9][0-9])"
    }
  ],
  "source_repository": {
    "default_url": "https://github.com/openedx/openedx-platform.git",
    "default_branch": "release/verawood.1",
    "presets": [
      { "label": "Stable (Verawood Release)", "value": "release/verawood.1" },
      { "label": "Tracking Branch (release/verawood)", "value": "release/verawood" },
      { "label": "Development (master)", "value": "master" }
    ],
    "supports_auth_token": true
  },
  "browser_launch": {
    "targets": [
      {
        "id": "LAUNCH_BROWSER",
        "title": "Launch Open edX LMS in Web Browser",
        "default": true,
        "url_template": "http://[PROP_LMS_HOST]:[PROP_LMS_PORT]/login"
      },
      {
        "id": "LAUNCH_STUDIO",
        "title": "Launch Open edX Studio in Web Browser",
        "default": true,
        "url_template": "http://[PROP_CMS_HOST]:[PROP_CMS_PORT]/signin"
      }
    ]
  },
  "features": [
    {
      "id": "core",
      "title": "Open edX LMS & Studio Core Services",
      "description": "Core Django WSGI services for LMS and Studio CMS.",
      "default": true,
      "mandatory": true
    },
    {
      "id": "workers",
      "title": "Celery Background Workers & Scheduler",
      "description": "Asynchronous task workers (lms-worker, cms-worker) and periodic beat scheduler.",
      "default": true,
      "mandatory": false
    },
    {
      "id": "demo_content",
      "title": "Demo Course & Content Libraries",
      "description": "Ingest the official edX demonstration course and reusable content libraries.",
      "default": false,
      "mandatory": false
    },
    {
      "id": "mfes",
      "title": "Micro-Frontend Applications (MFEs)",
      "description": "Production builds for Learning, Authn, Account, and Course Authoring MFEs.",
      "default": false,
      "mandatory": false
    },
    {
      "id": "theming",
      "title": "Comprehensive Theming & Branding Engine",
      "description": "Compile and apply custom corporate or institutional branding themes.",
      "default": false,
      "mandatory": false
    }
  ],
  "shortcuts": [
    {
      "id": "SC_CLI",
      "title": "Open edX Management Console",
      "target": "[INSTALLFOLDER]cli.cmd",
      "arguments": "",
      "icon": "openedx.ico",
      "description": "Command-line administrative interface for Open edX operations."
    },
    {
      "id": "SC_HEALTHCHECK",
      "title": "Open edX Healthcheck & Diagnostics",
      "target": "[INSTALLFOLDER]healthcheck.cmd",
      "arguments": "",
      "icon": "openedx.ico",
      "description": "Full-stack health diagnostic probe for all Open edX services."
    },
    {
      "id": "SC_DBSHELL",
      "title": "Open edX Database Console",
      "target": "[INSTALLFOLDER]dbshell.cmd",
      "arguments": "mysql",
      "icon": "openedx.ico",
      "description": "Interactive relational database shell connected to Open edX."
    },
    {
      "id": "SC_BACKUP",
      "title": "Open edX Backup & Restore",
      "target": "[INSTALLFOLDER]backup.cmd",
      "arguments": "",
      "icon": "openedx.ico",
      "description": "Automated snapshot backup and disaster recovery console."
    }
  ],
  "post_install": [
    {
      "id": "healthcheck",
      "description": "Validate service availability and connectivity across stack components",
      "command": "[INSTALLFOLDER]healthcheck.cmd",
      "optional": true,
      "condition": "NOT Installed"
    },
    {
      "id": "workers_start",
      "description": "Start Celery background worker daemons and periodic scheduler",
      "command": "[INSTALLFOLDER]workers.cmd start",
      "optional": true,
      "condition": "INSTALL_WORKERS=\"1\""
    },
    {
      "id": "import_demo",
      "description": "Import edX demonstration course and content library catalog",
      "command": "[INSTALLFOLDER]import_demo.cmd course",
      "optional": true,
      "condition": "IMPORT_DEMO_CONTENT=\"1\""
    }
  ]
}
