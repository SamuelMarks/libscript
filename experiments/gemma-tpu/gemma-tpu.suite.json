{
  "$schema": "../../../experiments/schemas/experiment-suite.schema.json",
  "id": "gemma_tpu",
  "title": "Gemma 4 7-Backend Cloud TPU & TFRC Zero-Cost Evaluation Suite",
  "protocol_version": "1.0.0",
  "subsuites": [
    {
      "id": "E0",
      "name": "TFRC Policy, Topology, Wheel Lock & Stage A TPU Probe Provenance",
      "script": "experiments/gemma-tpu/suites/e0_tfrc_provenance.sh",
      "outputs": ["raw/e0_provenance.json"]
    },
    {
      "id": "E1",
      "name": "7-Backend Gemma 4 Inference Prefill & Decode Throughput",
      "script": "experiments/gemma-tpu/suites/e1_inference_throughput.sh",
      "outputs": ["raw/e1_inference_*.json"]
    },
    {
      "id": "E2",
      "name": "7-Backend Text-to-SQL DuckDB/SQLite Execution Accuracy & Latency",
      "script": "experiments/gemma-tpu/suites/e2_sql_evaluation.sh",
      "outputs": ["raw/e2_sql_eval_*.json"]
    },
    {
      "id": "E3",
      "name": "7-Backend SFT, LoRA (PEFT), and DPO Training Throughput",
      "script": "experiments/gemma-tpu/suites/e3_training_finetuning.sh",
      "outputs": ["raw/e3_training_*.json"]
    },
    {
      "id": "E4",
      "name": "Custom Command Matrix & 7-Backend Cross-Framework Synthesis",
      "script": "experiments/gemma-tpu/suites/e4_custom_matrix_and_synthesis.sh",
      "outputs": [
        "comparison_summary.json",
        "comparison_summary.csv",
        "comparison_summary.md",
        "generated_metrics.tex"
      ]
    }
  ],
  "tpu_matrix": {
    "tfrc_policy_path": "tfrc.policy.json",
    "fresh_vm_per_backend": false,
    "require_tpu_hbm_activity": true,
    "backends": [
      {
        "id": "hf_transformers",
        "label": "Hugging Face Transformers [wraps PyTorch]",
        "venv_group": "pytorch-xla",
        "cli_backend": "pytorch_hf",
        "tpu_runtime_version": "auto",
        "pip_find_links": ["https://storage.googleapis.com/libtpu-releases/index.html"],
        "pip_packages": [
          "torch",
          "torch_xla[tpu]",
          "transformers",
          "accelerate",
          "peft",
          "safetensors",
          "datasets"
        ],
        "env": {
          "PJRT_DEVICE": "TPU",
          "XLA_USE_BF16": "1",
          "HF_HOME": "/dev/shm/libscript-tpu/cache/hf"
        }
      },
      {
        "id": "pytorch_native",
        "label": "PyTorch [native]",
        "venv_group": "pytorch-xla",
        "cli_backend": "pytorch_native",
        "tpu_runtime_version": "auto",
        "pip_find_links": ["https://storage.googleapis.com/libtpu-releases/index.html"],
        "pip_packages": [
          "torch",
          "torch_xla[tpu]",
          "transformers",
          "accelerate",
          "peft",
          "safetensors",
          "datasets"
        ],
        "env": {
          "PJRT_DEVICE": "TPU",
          "XLA_USE_BF16": "1",
          "HF_HOME": "/dev/shm/libscript-tpu/cache/hf"
        }
      },
      {
        "id": "keras_jax",
        "label": "Keras [JAX backend]",
        "venv_group": "keras-jax",
        "cli_backend": "keras",
        "keras_backend": "jax",
        "tpu_runtime_version": "auto",
        "pip_find_links": ["https://storage.googleapis.com/jax-releases/libtpu_releases.html"],
        "pip_packages": ["jax[tpu]", "keras>=3", "keras-hub", "keras-nlp", "tensorflow-cpu"],
        "env": {
          "KERAS_BACKEND": "jax",
          "JAX_PLATFORMS": "tpu",
          "KERAS_HOME": "/dev/shm/libscript-tpu/cache/keras"
        }
      },
      {
        "id": "keras_tensorflow",
        "label": "Keras [TensorFlow backend]",
        "venv_group": "keras-tf",
        "cli_backend": "keras",
        "keras_backend": "tensorflow",
        "tpu_runtime_version": "auto",
        "pip_packages": ["tensorflow-tpu", "keras>=3", "keras-hub", "keras-nlp"],
        "env": {
          "KERAS_BACKEND": "tensorflow",
          "KERAS_HOME": "/dev/shm/libscript-tpu/cache/keras"
        }
      },
      {
        "id": "keras_pytorch",
        "label": "Keras [PyTorch backend]",
        "venv_group": "keras-torch",
        "cli_backend": "keras",
        "keras_backend": "torch",
        "tpu_runtime_version": "auto",
        "pip_find_links": ["https://storage.googleapis.com/libtpu-releases/index.html"],
        "pip_packages": [
          "torch",
          "torch_xla[tpu]",
          "keras>=3",
          "keras-hub",
          "keras-nlp",
          "tensorflow-cpu"
        ],
        "env": {
          "KERAS_BACKEND": "torch",
          "PJRT_DEVICE": "TPU",
          "XLA_USE_BF16": "1",
          "KERAS_HOME": "/dev/shm/libscript-tpu/cache/keras"
        }
      },
      {
        "id": "maxtext",
        "label": "MaxText [wraps JAX]",
        "venv_group": "maxtext",
        "cli_backend": "maxtext",
        "tpu_runtime_version": "auto",
        "pip_find_links": ["https://storage.googleapis.com/jax-releases/libtpu_releases.html"],
        "pip_packages": [
          "jax[tpu]",
          "flax",
          "optax",
          "orbax-checkpoint",
          "omegaconf",
          "einops",
          "grain",
          "aqt",
          "maxtext"
        ],
        "env": {
          "JAX_PLATFORMS": "tpu",
          "HF_HOME": "/dev/shm/libscript-tpu/cache/hf"
        }
      },
      {
        "id": "jax_native",
        "label": "JAX [native]",
        "venv_group": "jax-native",
        "cli_backend": "jax",
        "tpu_runtime_version": "auto",
        "pip_find_links": ["https://storage.googleapis.com/jax-releases/libtpu_releases.html"],
        "pip_packages": ["jax[tpu]", "flax", "optax", "orbax-checkpoint", "grain", "datasets"],
        "env": {
          "JAX_PLATFORMS": "tpu",
          "HF_HOME": "/dev/shm/libscript-tpu/cache/hf"
        }
      }
    ],
    "workloads": [
      {
        "id": "e1_inference",
        "category": "inference",
        "command_template": "gemma-4-sql benchmark --model {model} --hardware tpu --dtype bfloat16 --mode decode --batch-size {batch_size} --backend {cli_backend} --output {output_json}",
        "warmup_runs": 2,
        "measured_trials": 5
      },
      {
        "id": "e2_sql_eval",
        "category": "sql_eval",
        "command_template": "gemma-4-sql evaluate --model {model} --hardware tpu --seed 42 --backend {cli_backend} --output {output_json}",
        "warmup_runs": 1,
        "measured_trials": 3
      },
      {
        "id": "e3_training",
        "category": "training",
        "command_template": "gemma-4-sql peft --model {model} --hardware tpu --dtype bfloat16 --backend {cli_backend} --output {output_json}",
        "warmup_runs": 1,
        "measured_trials": 3
      }
    ]
  }
}
