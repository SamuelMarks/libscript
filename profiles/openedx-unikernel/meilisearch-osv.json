{
  "schema_version": "1.0.0",
  "profile_name": "openedx-meilisearch-osv",
  "description": "Single-address-space Open edX search unikernel appliance (unikernel-osv / osv-kernel).",
  "target": {
    "arch": "x86_64",
    "os_family": "unikernel-osv",
    "libc": "glibc",
    "platform": "aws"
  },
  "kernel": {
    "provider": "osv-kernel",
    "config_method": "tinyconfig",
    "cmdline": "meilisearch --http-addr 0.0.0.0:7700"
  },
  "init_system": {
    "provider": "unikernel-entrypoint"
  },
  "storage": {
    "disk_size_gib": 10,
    "partition_table": "gpt",
    "boot_mode": "uefi",
    "bootloader": "unikernel-direct"
  },
  "output_formats": ["direct-kernel", "qcow2", "aws-ami", "azure-vhd", "gcp-image"],
  "components": ["meilisearch"]
}
