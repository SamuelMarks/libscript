{
  "schema_version": "1.0.0",
  "profile_name": "linux-debian-style-minimal",
  "description": "Ultra-stripped Debian container and base image profile (< 35MB rootfs) with Glibc and minimal dpkg.",
  "target": {
    "arch": "x86_64",
    "os_family": "linux-glibc",
    "libc": "glibc",
    "distro_style": "debian-style",
    "platform": "docker"
  },
  "package_manager": {
    "provider": "apt",
    "suite_or_branch": "stable",
    "core_distribution_packages": ["base-files", "dpkg"]
  },
  "kernel": {
    "provider": "none",
    "config_method": "defconfig"
  },
  "init_system": {
    "provider": "none",
    "default_target": "multi-user",
    "services_enabled": []
  },
  "container": {
    "entrypoint": ["/bin/sh"],
    "working_dir": "/"
  },
  "storage": {
    "disk_size_gib": 2,
    "partition_table": "none",
    "boot_mode": "none",
    "bootloader": "none"
  },
  "locale": {
    "lang": "C.UTF-8",
    "keymap": "us",
    "timezone": "UTC"
  },
  "packages": ["glibc", "coreutils"]
}
