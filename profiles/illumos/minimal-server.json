{
  "schema_version": "1.0.0",
  "profile_name": "minimal-server",
  "description": "Minimal illumos headless server with SMF, ZFS root pool, and minimal core userland.",
  "illumos_version": "r151048",
  "target": {
    "arch": "amd64",
    "os_family": "illumos",
    "flavor": "omnios",
    "libc": "sunos-libc"
  },
  "init_system": {
    "provider": "smf",
    "milestone": "svc:/milestone/multi-user-server:default",
    "services_enabled": [
      "svc:/network/ssh:default",
      "svc:/system/cron:default",
      "svc:/system/system-log:default"
    ]
  },
  "display": {
    "protocol": "none",
    "graphics_driver": "none"
  },
  "desktop": {
    "environment": "none",
    "display_manager": "none"
  },
  "audio": {
    "subsystem": "none"
  },
  "storage": {
    "filesystem": "zfs",
    "pool_name": "rpool",
    "bootloader": "illumos-loader",
    "disk_size_gib": 16,
    "compression": "lz4"
  },
  "package_manager": {
    "provider": "ips",
    "publisher_url": "https://pkg.omnios.org/r151048/core",
    "catalog": "core"
  },
  "users": [
    {
      "username": "root",
      "shell": "/bin/sh",
      "groups": ["root"],
      "sudo": true
    },
    {
      "username": "admin",
      "shell": "/bin/sh",
      "groups": ["staff", "sysadmin"],
      "rbac_profiles": ["Primary Administrator"],
      "sudo": true
    }
  ],
  "network": {
    "hostname": "illumos-minimal",
    "dhcp": true,
    "interface_strategy": "ipadm",
    "dns_servers": ["1.1.1.1", "8.8.8.8"]
  },
  "packages": [
    "pkg:/system/core-os",
    "pkg:/service/network/ssh",
    "pkg:/network/curl",
    "pkg:/security/sudo"
  ]
}
