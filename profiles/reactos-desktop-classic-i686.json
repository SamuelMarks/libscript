{
  "$schema": "../execution-plan.reactos.schema.json",
  "schema_version": "1.0.0",
  "profile_name": "reactos-desktop-classic-i686",
  "description": "Full 32-bit ReactOS 0.4.16 classic Win32 Explorer desktop with Lautus visual style, VBE 1024x768x32 graphics, AC97 audio, and pre-installed RAPPS default apps.",
  "reactos_version": "0.4.16",
  "build_mode": "repack",
  "target": {
    "arch": "i686",
    "os_family": "reactos",
    "channel": "release",
    "image_variant": "bootcd",
    "libc": "msvcrt"
  },
  "init_system": {
    "provider": "nt-scm",
    "services_enabled": ["dhcp", "eventlog", "rpcss", "umpnpmgr", "winmgmt"]
  },
  "display": {
    "protocol": "win32-gdi",
    "graphics_driver": "vbemp",
    "resolution": "1024x768x32"
  },
  "desktop": {
    "shell": "explorer-classic",
    "theme": "lautus",
    "autologin_user": "admin"
  },
  "audio": {
    "subsystem": "ac97"
  },
  "storage": {
    "filesystem": "fat32",
    "bootloader": "freeldr",
    "partition_table": "mbr",
    "boot_mode": "bios-legacy",
    "disk_size_gib": 8,
    "serial_debug": true
  },
  "package_manager": {
    "provider": "rapps",
    "offline_prefetch": true
  },
  "unattend": {
    "enabled": true,
    "computer_name": "REACTOS-DESK",
    "locale_id": "00000409",
    "time_zone_index": 85,
    "disable_gecko_inst": true
  },
  "users": [
    {
      "username": "admin",
      "password": "vagrant",
      "groups": ["Administrators"],
      "admin": true
    }
  ],
  "network": {
    "hostname": "reactos-desktop",
    "dhcp": true,
    "dns_servers": ["1.1.1.1", "8.8.8.8"]
  },
  "rapps_packages": ["7zip", "sumatrapdf", "notepadpp", "vlc"],
  "components": ["curl", "jq"]
}
