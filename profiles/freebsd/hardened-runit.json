{
  "schema_version": "1.0.0",
  "profile_name": "hardened-runit",
  "description": "Hardened, minimal footprint FreeBSD distribution supervised by runit.",
  "freebsd_version": "14.1-RELEASE",
  "target": {
    "arch": "amd64",
    "os_family": "freebsd",
    "libc": "bsd-libc"
  },
  "init_system": {
    "provider": "runit",
    "services_enabled": ["sshd", "devd", "syslogd"]
  },
  "display": {
    "protocol": "none",
    "graphics_driver": "none"
  },
  "desktop": {
    "environment": "none",
    "display_manager": "none"
  },
  "audio": {
    "subsystem": "none"
  },
  "storage": {
    "filesystem": "ufs2",
    "bootloader": "freebsd-loader",
    "disk_size_gib": 15
  },
  "users": [
    {
      "username": "admin",
      "shell": "/bin/sh",
      "groups": ["wheel"],
      "sudo": true
    }
  ],
  "network": {
    "hostname": "freebsd-runit",
    "dhcp": true,
    "dns_servers": ["1.1.1.1", "8.8.8.8"]
  },
  "packages": [
    "runit",
    "doas",
    "ca_root_nss"
  ]
}
