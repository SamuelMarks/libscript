{
  "schema_version": "1.0.0",
  "profile_name": "unikernel-mirageos-https",
  "description": "MirageOS OCaml library-OS unikernel compiled for Solo5 hardware-virtualized tender (solo5-hvt).",
  "target": {
    "arch": "x86_64",
    "os_family": "unikernel-mirageos",
    "libc": "mirage-ocaml",
    "platform": "solo5-hvt"
  },
  "kernel": {
    "provider": "mirage-solo5-hvt",
    "version": "4.8.0",
    "config_method": "defconfig"
  },
  "init_system": {
    "provider": "unikernel-entrypoint"
  },
  "storage": {
    "disk_size_gib": 1,
    "partition_table": "none",
    "boot_mode": "direct-kernel",
    "bootloader": "unikernel-direct"
  },
  "output_formats": ["direct-kernel"],
  "components": ["mirage"]
}
