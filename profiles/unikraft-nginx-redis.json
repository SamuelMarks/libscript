{
  "schema_version": "1.0.0",
  "profile_name": "unikraft-nginx-redis",
  "description": "Unikraft single-address-space microkernel unikernel image optimized for high-performance Nginx and Redis workloads.",
  "target": {
    "arch": "x86_64",
    "os_family": "unikernel-unikraft",
    "libc": "nolibc",
    "submodel": "generic"
  },
  "kernel": {
    "provider": "unikraft-core",
    "config_method": "defconfig",
    "fragments": ["plat_kvm.cfg", "lib_nolibc.cfg", "app_nginx.cfg"],
    "cmdline": "netdev.ip=172.44.0.2 netdev.gw=172.44.0.1 netdev.mask=255.255.255.0"
  },
  "init_system": {
    "provider": "none",
    "default_target": "multi-user",
    "services_enabled": []
  },
  "display": {
    "server": "headless",
    "compositor": "none"
  },
  "desktop": {
    "desktop_suite": "none",
    "greeter": "none"
  },
  "storage": {
    "disk_size_gib": 1,
    "partition_table": "mbr",
    "boot_mode": "bios-legacy",
    "bootloader": "none",
    "uki": false,
    "partitions": [
      {
        "name": "root",
        "filesystem": "vfat",
        "mountpoint": "/",
        "size_mib": 64
      }
    ]
  },
  "users": [
    {
      "username": "root",
      "shell": "/bin/sh",
      "groups": ["root"],
      "sudo": true
    }
  ],
  "locale": {
    "lang": "C",
    "keymap": "us",
    "timezone": "UTC"
  },
  "network": {
    "hostname": "unikraft-app",
    "dhcp": false,
    "dns_servers": ["1.1.1.1"]
  },
  "offline": {
    "enabled": false,
    "cache_dir": "/var/cache/libscript"
  },
  "packages": ["unikraft", "nginx", "redis"]
}
