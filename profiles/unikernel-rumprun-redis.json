{
  "schema_version": "1.0.0",
  "profile_name": "unikernel-rumprun-redis",
  "description": "NetBSD Rumprun hw_virtio unikernel baking Redis with a persistent stubfs AOF block volume.",
  "target": {
    "arch": "x86_64",
    "os_family": "unikernel-rumprun",
    "libc": "rump-libc",
    "platform": "qemu"
  },
  "kernel": {
    "provider": "rumprun-hw",
    "version": "0.2.0",
    "config_method": "defconfig"
  },
  "init_system": {
    "provider": "unikernel-entrypoint"
  },
  "storage": {
    "disk_size_gib": 1,
    "partition_table": "none",
    "boot_mode": "direct-kernel",
    "bootloader": "unikernel-direct"
  },
  "output_formats": ["direct-kernel", "live-iso"],
  "components": ["redis"]
}
