{
  "schema_version": "1.0.0",
  "profile_name": "unikernel-osv-redis-postgres",
  "description": "OSv cloud unikernel appliance pairing Redis and PostgreSQL shared-object workloads atop ZFS.",
  "target": {
    "arch": "x86_64",
    "os_family": "unikernel-osv",
    "libc": "glibc",
    "platform": "kvm"
  },
  "kernel": {
    "provider": "osv-kernel",
    "version": "0.58.0",
    "config_method": "defconfig"
  },
  "init_system": {
    "provider": "unikernel-entrypoint"
  },
  "storage": {
    "disk_size_gib": 8,
    "partition_table": "gpt",
    "boot_mode": "direct-kernel",
    "bootloader": "unikernel-direct"
  },
  "output_formats": ["qcow2", "direct-kernel"],
  "components": ["redis", "postgres"]
}
