{
  "schema_version": "1.0.0",
  "profile_name": "openedx-caddy-mfe-unikraft",
  "description": "Single-address-space Open edX mfe-static unikernel appliance (unikernel-unikraft / unikraft-core).",
  "target": {
    "arch": "x86_64",
    "os_family": "unikernel-unikraft",
    "libc": "musl",
    "platform": "aws"
  },
  "kernel": {
    "provider": "unikraft-core",
    "config_method": "tinyconfig",
    "cmdline": "caddy run --config /etc/caddy/Caddyfile"
  },
  "init_system": {
    "provider": "unikernel-entrypoint"
  },
  "storage": {
    "disk_size_gib": 10,
    "partition_table": "gpt",
    "boot_mode": "uefi",
    "bootloader": "unikernel-direct"
  },
  "output_formats": ["direct-kernel", "qcow2", "aws-ami", "azure-vhd", "gcp-image"],
  "components": ["caddy"]
}
