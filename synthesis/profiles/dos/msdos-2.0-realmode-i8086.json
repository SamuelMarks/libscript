{
  "$schema": "../../schemas/execution-plan.dos.schema.json",
  "schema_version": "1.0.0",
  "profile_name": "msdos-2.0-realmode-i8086",
  "description": "Microsoft MIT MS-DOS 2.00 16-bit 8086 FAT12 image with clean-room IO.SYS and win-cmd-asm (WINCMD.COM SHELL= + 17 CRT-free utilities).",
  "dos_flavor": "msdos",
  "dos_version": "2.0",
  "build_mode": "from-source",
  "shell_provider": "win-cmd-asm",
  "dpmi_provider": "none",
  "djgpp_userland": false,
  "lfn_enabled": false,
  "serial_console": "com1",
  "packet_driver": "none",
  "config_sys": {
    "files": 20,
    "buffers": 10,
    "lastdrive": "E",
    "dos_high_umb": false
  },
  "target": {
    "arch": "i8086",
    "os_family": "msdos",
    "libc": "dos16-libc",
    "platform": "qemu"
  },
  "kernel": {
    "provider": "msdos-mit-2.0",
    "version": "2.0",
    "config_method": "defconfig"
  },
  "init_system": {
    "provider": "dos-autoexec"
  },
  "storage": {
    "media_type": "floppy-1440k",
    "disk_size_gib": 1,
    "partition_table": "none",
    "boot_mode": "bios-legacy",
    "bootloader": "dos-mbr-vbr",
    "partitions": [
      {
        "name": "MSDOS20",
        "filesystem": "fat12",
        "mountpoint": "A:\\",
        "size_mib": 1
      }
    ]
  },
  "output_formats": ["floppy-img", "qcow2", "vagrant-box"],
  "components": ["win-cmd-asm"]
}
