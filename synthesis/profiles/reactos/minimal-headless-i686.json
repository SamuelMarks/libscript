{
  "$schema": "../../synthesis/schemas/execution-plan.reactos.schema.json",
  "schema_version": "1.0.0",
  "profile_name": "minimal-headless-i686",
  "description": "Minimal headless 32-bit ReactOS 0.4.16 appliance with cmd-minimal shell, FASTFAT root, COM1 115200 serial console, and portable Win32 bootstrap tools.",
  "reactos_version": "0.4.16",
  "build_mode": "repack",
  "target": {
    "arch": "i686",
    "os_family": "reactos",
    "channel": "release",
    "image_variant": "bootcd",
    "libc": "msvcrt"
  },
  "init_system": {
    "provider": "nt-scm",
    "services_enabled": ["dhcp", "eventlog", "rpcss", "umpnpmgr"]
  },
  "display": {
    "protocol": "none",
    "graphics_driver": "vga",
    "resolution": "800x600x16"
  },
  "desktop": {
    "shell": "cmd-minimal",
    "theme": "classic"
  },
  "audio": {
    "subsystem": "none"
  },
  "storage": {
    "filesystem": "fat32",
    "bootloader": "freeldr",
    "partition_table": "mbr",
    "boot_mode": "bios-legacy",
    "disk_size_gib": 4,
    "serial_debug": true
  },
  "package_manager": {
    "provider": "rapps",
    "offline_prefetch": true
  },
  "unattend": {
    "enabled": true,
    "computer_name": "REACTOS-MIN",
    "locale_id": "00000409",
    "time_zone_index": 85,
    "disable_gecko_inst": true
  },
  "network": {
    "hostname": "reactos-min",
    "dhcp": true,
    "dns_servers": ["1.1.1.1", "8.8.8.8"]
  },
  "offline": {
    "enabled": true,
    "cache_dir": "C:\\libscript\\cache"
  },
  "components": ["7zip", "curl", "jq", "sqlite-tools"]
}
